            text: "Open Schedule",
            iconId: "calendar",
            callback: async () => {
              await openSchedule(char);
            }
          }
        ]
      },
    ];
  }
  else if (page === "Opening")
  {
    return [
      {
        type: "text",
        markdown: true,
        text: `# Opening\n**Optional opening defaults**`
      },
      {
        type: "multilineTextInput",
        label: "Greeting Message",
        initialValue: char.greeting,
