interface RememberMeEntry {
  text: string,
  id: string // uuid on creation
}

let rememberMeRecord: Record<string, RememberMeEntry[]> = {};
const REMEMBER_ME_KEY = "rememberMeKey";
await api.v1.storyStorage.setIfAbsent(REMEMBER_ME_KEY, rememberMeRecord);
rememberMeRecord = await api.v1.storyStorage.get(REMEMBER_ME_KEY);

const REMEMBER_ME_FEATURE_NAME = "Jots";

const REMEMBER_ME_DISPLAY_ID = "rememberMeDisplayEntries";

const REMEMBER_ME_FILE_TYPE_ID = "rememberMe";

async function rememberMeImport(scriptPermission: ScriptPermission, combinedId: string)
{
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  const file = await api.v1.file.prompt({ accept: '.json' });
  if (!file) return;
  
  try {
    const data = JSON.parse(file);
    if (data.fileType){
      if (data.fileType != REMEMBER_ME_FILE_TYPE_ID){
        api.v1.ui.toast(`Data type is not ${REMEMBER_ME_FILE_TYPE_ID}. Canceling import.`, {type: "warning"});
        return;
      }
    }

    // Use these to show Skip/Overwrite option in bulk after traversing imported data.
    let dupeExistingIndexList: number[] = [];
    let dupeImportedIndexList: number[] = [];
    let dupeCount = 0;

    // Compare with existing and check for overwrite.
    const importedList: RememberMeEntry[] = data.entries;
    for (let i = 0; i < importedList.length; i++){
      const existingIdIndex = rememberMeRecord[combinedId].findIndex(existingItem => existingItem.id === importedList[i].id);
      if (existingIdIndex !== -1){
        dupeExistingIndexList.push(existingIdIndex);
        dupeImportedIndexList.push(i);
        dupeCount++;
      }
      else{
        rememberMeRecord[combinedId].push(importedList[i]);
      }
    }
    if (dupeCount > 0){
      let dupeNewPartsList: UIPart[] = [];
      let dupeCurrentPartsList: UIPart[] = [];
      for (let i = 0; i < dupeCount; i++){
        const importI = dupeImportedIndexList[i];
        dupeNewPartsList.push(
          {
            type: "container",
            style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
            content: [
              {
                type: "text",
                noTemplate: true,
                style: { textAlign: "center" },
                text: `${importedList[importI].id}\n${importedList[importI].text}`
              }
            ]
          }
        );
        const existingI = dupeExistingIndexList[i];
        dupeCurrentPartsList.push(
          {
            type: "container",
            style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
            content: [
              {
                type: "text",
                noTemplate: true,
                style: { textAlign: "center" },
                text: `${rememberMeRecord[combinedId][existingI].id}\n${rememberMeRecord[combinedId][existingI].text}`
              }
            ]
          }
        );
      }
      
      // Bring up a modal to choose Skip/Overwrite in bulk
      const overwriteCheckModal = await api.v1.ui.modal.open({
        title: `Import ${REMEMBER_ME_FEATURE_NAME}`,
        content: [
          {
            type: "row",
            alignment: "center",
            spacing: "center",
            content: [
              {
                type: "text",
                text: `This file contains entries already present (same id) in the current ${REMEMBER_ME_FEATURE_NAME}, would you like to overwrite them?`
              },
            ]
          },
          {
            type: "row",
            alignment: "center",
            spacing: "space-around",
            content: [
              {
                type: "button",
                text: "Skip",
                callback: () => {
                  // Don't need to do anything more. Relevant data has already been imported.
                  overwriteCheckModal.close();
                }
              },
              {
                type: "button",
                text: "Overwrite",
                callback: () => {
                  for (let i = 0; i < dupeCount; i++){
                    const importI = dupeImportedIndexList[i];
                    const existingI = dupeExistingIndexList[i];
                    rememberMeRecord[combinedId][existingI].text = importedList[importI].text;
                  }
                  overwriteCheckModal.close();
                }
              },
            ]
          },
          {
            type: "row",
            alignment: "center",
            spacing: "start",
            content: [
              {
                type: "text",
                text: "Same ID"
              },
            ]
          },
          {
            type: "row",
            alignment: "center",
            spacing: "center",
            content: [
              {
                type: "column",
                content: [
                  {
                    type: "text",
                    style: { textAlign: "center" },
                    text: "New"
                  },
                  ...dupeNewPartsList
                ]
              },
              {
                type: "column",
                content: [
                  {
                    type: "text",
                    style: { textAlign: "center" },
                    text: "Current"
                  },
                  ...dupeCurrentPartsList
                ]
              },
            ]
          },
        ]
      });
      overwriteCheckModal.closed.then( async () => {
        await updateRememberMeUi(combinedId);
      });
    }
    else{
      await updateRememberMeUi(combinedId);
    }
    await saveRememberMeList();
  } catch (e) {
    api.v1.error(`Failed to import ${REMEMBER_ME_FEATURE_NAME}:`, e);
  }
}

async function rememberMeExport(scriptPermission: ScriptPermission, combinedId: string)
{
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  if (hasPermission){
    const currentDate = new Date();
    const suggestedName = `AR_${REMEMBER_ME_FEATURE_NAME}_${currentDate.toLocaleDateString()}_${currentDate.toLocaleTimeString().replace(" ", "_")}.json`;
    const namedData = {
      fileType: REMEMBER_ME_FILE_TYPE_ID,
      format: CARD_FORMAT,
      entries: rememberMeRecord[combinedId]
    };
    await api.v1.file.save(suggestedName, JSON.stringify(namedData, null, 2));
  }
}

async function saveRememberMeList()
{
  await api.v1.storyStorage.set(REMEMBER_ME_KEY, rememberMeRecord);
}

async function updateRememberMeUi(combinedId: string)
{
  await api.v1.ui.updateParts(
    [
      {
        id: REMEMBER_ME_DISPLAY_ID, 
        content: [...rebuildRememberMeUi(combinedId)]
      }
    ]
  );
}

function rebuildRememberMeUi(combinedId: string) : UIPart[]
{
  let uiPartsList: UIPart[] = [];
  for (let i = 0; i < rememberMeRecord[combinedId].length; i++){
    uiPartsList.push(
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "textInput",
            initialValue: rememberMeRecord[combinedId][i].text,
            onChange: async (val: string) => {
              rememberMeRecord[combinedId][i].text = val;
              await saveRememberMeList();
            }
          },
          {
            type: "button",
            iconId: "delete",
            callback: async () => {
              let deletionCheckModal = await api.v1.ui.modal.open({
                title: "Delete Entry?",
                size: 'small',
                content: [
                  { type: "text", text: "Are you sure you want to delete the entry?" },
                  {
                    type: "text",
                    text: `Entry text: ${rememberMeRecord[combinedId][i].text}`
                  },
                  {
                    type: 'row',
                    style: { marginTop: '16px', gap: '8px', justifyContent: 'flex-end' },
                    content: [
                      { 
                        type: 'button', 
                        text: 'Cancel', 
                        callback: async () => { 
                          deletionCheckModal.close();
                        } 
                      },
                      {
                        type: 'button',
                        text: 'Delete',
                        iconId: 'trash',
                        callback: async () => {
                          rememberMeRecord[combinedId].splice(i, 1);
                          await saveRememberMeList();
                          await updateRememberMeUi(combinedId);
                          deletionCheckModal.close();
                        }
                      }
                    ]
                  }
                ]
              });
            }
          }
        ]
      },
    );
  }
  return uiPartsList;
}

async function openRememberMeUi()
{
  if (!chatSettings.char || !chatSettings.user){
    api.v1.ui.toast("Set a Contact and User to edit and store facts about you that you want the AI to know.");
    return;
  }

  const combinedId = chatSettings.char.id + chatSettings.user.id;

  // Make sure a combined id record exists, so we don't run into weird issues with it not existing and being undefined.
  if (!rememberMeRecord[combinedId]){
    rememberMeRecord[combinedId] = [];
  }

  const rememberMeModal = await api.v1.ui.modal.open({
    title: REMEMBER_ME_FEATURE_NAME,
    content: [
      {
        type: "container",
        style: { overflow: "scroll", maxHeight: "90%" },
        content: [
          {
            type: "text",
            markdown: true,
            text: "**Brief facts you want the AI to know about you**"
          },
          {
            type: "column",
            id: REMEMBER_ME_DISPLAY_ID,
            content: [
              ...rebuildRememberMeUi(combinedId)
            ]
          }
        ]
      },
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "button",
            iconId: "plus",
            callback: async () => {
              rememberMeRecord[combinedId].push(
                {
                  text: "",
                  id: api.v1.uuid()
                }
              );
              await saveRememberMeList();
              await updateRememberMeUi(combinedId);
            }
          },
          {
            type: "button",
            iconId: "sunset",
            callback: async () => {
              await rememberMeImport("fileInput", combinedId);
            }
          },
          {
            type: "button",
            iconId: "sunrise",
            callback: async () => {
              await rememberMeExport("fileDownload", combinedId);
            }
          },
        ]
      }
    ],
    size: "medium"
  });
}

type SummonerType = "contextMenuButton" | "toolbarButton";

function getDiariesAndBrainsSummonerTypeFromState(state: boolean) : SummonerType
{
  if (state){
    return "contextMenuButton";
  }
  else{
    return "toolbarButton";
  }
}
const diariesAndBrainsSummonerType: SummonerType = getDiariesAndBrainsSummonerTypeFromState(await api.v1.config.get("diariesAndBrainsSummonedByConfig"));

function getDiariesAndBrainsSummoner(summonerType: SummonerType) : UIExtension[]
{
  return [
    {
      type: summonerType,
      id: "arBrainsBtnId",
      text: "AR Brains",
      callback: async () => {
        await openFloatyBrains();
      }
    },
    {
      type: summonerType,
      id: "arDiariesBtnId",
      text: "AR Diaries",
      callback: async () => {
        await openDiaries();
      }
    },
  ];
}

interface FloatyBrain {
  id: string // uuid
  active: boolean
  entry: BrainEntry
}
let floatyBrainsList: FloatyBrain[] = [];
const FLOATY_BRAINS_KEY = "floatyBrainsKey";
await api.v1.storyStorage.setIfAbsent(FLOATY_BRAINS_KEY, floatyBrainsList);
floatyBrainsList = await api.v1.storyStorage.get(FLOATY_BRAINS_KEY);

interface FloatyState {
  id: string // uuid
  active: boolean
}

/**
 * Combined id as key for record (id of current Contact + User).
 * We do this so we can swap active state of existing Floaty Brains when Contact/User is changed.
 */
let floatyBrainsStateRecord: Record<string, FloatyState[]> = {};
const FLOATY_BRAINS_STATE_KEY = "floatyBrainsStateKey";
await api.v1.storyStorage.setIfAbsent(FLOATY_BRAINS_STATE_KEY, floatyBrainsStateRecord);
floatyBrainsStateRecord = await api.v1.storyStorage.get(FLOATY_BRAINS_STATE_KEY);

// List of ids only, for allowing the user to manage display order without changing list order itself and affecting cache.
let floatyActiveIdsList: string[] = [];
let floatyInactiveIdsList: string[] = [];
if (floatyBrainsList.length > 0){
  if (floatyActiveIdsList.length === 0){
    floatyActiveIdsList = floatyBrainsList
    .filter(item => item.active === true)
    .map(item => item.id);
  }
  if (floatyInactiveIdsList.length === 0){
    floatyInactiveIdsList = floatyBrainsList
    .filter(item => item.active === false)
    .map(item => item.id);
  }
}
const FLOATY_ACTIVE_IDS_KEY = "floatyActiveIdsKey";
const FLOATY_INACTIVE_IDS_KEY = "floatyInactiveIdsKey";
await api.v1.storyStorage.setIfAbsent(FLOATY_ACTIVE_IDS_KEY, floatyActiveIdsList);
await api.v1.storyStorage.setIfAbsent(FLOATY_INACTIVE_IDS_KEY, floatyInactiveIdsList);
floatyActiveIdsList = await api.v1.storyStorage.get(FLOATY_ACTIVE_IDS_KEY);
floatyInactiveIdsList = await api.v1.storyStorage.get(FLOATY_INACTIVE_IDS_KEY);

type FloatyPage = "EnabledEntries" | "DisabledEntries";

async function openFloatyBrains()
{
  if (!chatSettings.char || !chatSettings.user){
    api.v1.ui.toast("Set a Contact and User to access and set contextual Brains related to their chat.");
    return;
  }

  let currentPage: FloatyPage = "EnabledEntries";
  /*
  When opening modal, stored state related to Contact/User pairing overrides other stored state.
  So we do an operation on open where we go through list and compare:
    - If there's an combinedId entry with id matching the current entry id
      - Set current entry active state to that of combinedId entry state
  */
  const combinedId = chatSettings.char.id + chatSettings.user.id;

  // Make sure a combined id record exists, so we don't run into weird issues with it not existing and being undefined.
  if (!floatyBrainsStateRecord[combinedId]){
    floatyBrainsStateRecord[combinedId] = [];
  }

  if (floatyBrainsStateRecord[combinedId]){
    for (let brain of floatyBrainsList){
      const idMatchIndex = floatyBrainsStateRecord[combinedId].findIndex(state => state.id === brain.id);
      if (idMatchIndex !== -1){
        brain.active = floatyBrainsStateRecord[combinedId][idMatchIndex].active;
      }
      else{
        // If there's no match, this implies the brain came from a previous combinedId
        // and has not had its active state modified since (modification should add it and cause a match),
        // so we load it as disabled.
        brain.active = false;
      }
    }
  }
  // Do a save operation for both records to maintain any alterations on load
  await saveFloatyBrains();

  const floatyBrainsModal = await api.v1.ui.modal.open({
    title: "Floaty Brains",
    content: [
      {
        type: "container",
        style: { overflow: "scroll", maxHeight: "90%" },
        content: [
          {
            type: "text",
            markdown: true,
            text: "**Additional background info**"
          },
          {
            type: "row",
            alignment: "center",
            spacing: "start",
            content: [
              {
                type: "button",
                text: "Add Brain",
                callback: async () => {
                  const newUUID = api.v1.uuid();
                  floatyBrainsList.push({
                    id: newUUID,
                    active: true,
                    entry: {name: "New Brain", content: ""}
                  });
                  if (!floatyBrainsStateRecord[combinedId]){
                    floatyBrainsStateRecord[combinedId] = [];
                  }
                  floatyBrainsStateRecord[combinedId].push({
                    id: newUUID,
                    active: true,
                  });
                  if (currentPage === "EnabledEntries"){
                    floatyActiveIdsList.push(newUUID);
                  }
                  else if (currentPage === "DisabledEntries"){
                    floatyInactiveIdsList.push(newUUID);
                  }
                  await updateFloatyPage(combinedId, currentPage);
                  await saveFloatyBrains();
                }
              },
              {
                type: "button",
                iconId: "sunset",
                callback: async () => {
                  await floatyBrainsImport("fileInput", combinedId, currentPage);
                }
              },
              {
                type: "button",
                iconId: "sunrise",
                callback: async () => {
                  await floatyBrainsExport("fileDownload");
                }
              },
            ]
          },
          {
            type: "column",
            id: "brainDisplayContainerFloaty",
            content: [
              ...floatyBrainRebuild(combinedId, currentPage, floatyActiveIdsList)
            ]
          }
        ]
      },
      {
        type: "row",
        spacing: "center",
        content: [
          {
            type: "button",
            text: "Active",
            iconId: "eye",
            callback: async () => {
              currentPage = "EnabledEntries";
              await updateFloatyPage(combinedId, currentPage);
            }
          },
          {
            type: "button",
            text: "Inactive",
            iconId: "eye-off",
            callback: async () => {
              currentPage = "DisabledEntries";
              await updateFloatyPage(combinedId, currentPage);
            }
          },
        ]
      }
    ],
    size: "medium"
  });
}

async function saveFloatyBrains()
{
  await api.v1.storyStorage.set(FLOATY_BRAINS_KEY, floatyBrainsList);
  await api.v1.storyStorage.set(FLOATY_BRAINS_STATE_KEY, floatyBrainsStateRecord);
  await api.v1.storyStorage.set(FLOATY_ACTIVE_IDS_KEY, floatyActiveIdsList);
  await api.v1.storyStorage.set(FLOATY_INACTIVE_IDS_KEY, floatyInactiveIdsList);
}

function floatyBrainRebuild(combinedId: string, currentPage: FloatyPage, idsList: string[]) : UIPart[]
{
  let brainPartsList: UIPart[] = [];
  for (let idI = 0; idI < idsList.length; idI++){
    const mainI = floatyBrainsList.findIndex(item => item.id === idsList[idI]);
    if (mainI === -1){
      continue;
    }
    brainPartsList.push(
      {
        type: "container",
        style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
        content: [
          {
            type: "row",
            content: [
              {
                type: "column",
                style: { minWidth: "90%" },
                content: [
                  {
                    type: "checkboxInput",
                    label: "Active",
                    initialValue: floatyBrainsList[mainI].active,
                    onChange: async (val) => {
                      floatyBrainsList[mainI].active = val;
                      // If there's a corresponding combined id state stored, we want to modify that too.
                      // If there isn't, we create one.
                      const idMatchIndex = floatyBrainsStateRecord[combinedId].findIndex(state => state.id === floatyBrainsList[mainI].id);
                      if (idMatchIndex === -1){
                        floatyBrainsStateRecord[combinedId].unshift({
                          id: floatyBrainsList[mainI].id,
                          active: floatyBrainsList[mainI].active,
                        });
                      }
                      else{
                        floatyBrainsStateRecord[combinedId][idMatchIndex].id = floatyBrainsList[mainI].id;
                        floatyBrainsStateRecord[combinedId][idMatchIndex].active = floatyBrainsList[mainI].active;
                      }
                      // Update location of id too, for ordering.
                      const spliced = idsList.splice(idI, 1)[0];
                      if (val === true){
                        // For moving to active, we place it at the top so it's easy to find.
                        floatyActiveIdsList.unshift(spliced);
                      }
                      else{
                        // For moving to inactive, we place at bottom, assuming user won't care to find it again easily.
                        floatyInactiveIdsList.push(spliced);
                      }
                      await updateFloatyPage(combinedId, currentPage);
                      await saveFloatyBrains();
                    }
                  },
                  {
                    type: "textInput",
                    label: "Name",
                    initialValue: floatyBrainsList[mainI].entry.name,
                    onChange: async (val) => {
                      floatyBrainsList[mainI].entry.name = val;
                      await saveFloatyBrains();
                    }
                  },
                  {
                    type: "multilineTextInput",
                    label: "Content",
                    initialValue: floatyBrainsList[mainI].entry.content,
                    onChange: async (val) => {
                      floatyBrainsList[mainI].entry.content = val;
                      await saveFloatyBrains();
                    }
                  },
                  {
                    type: "row",
                    spacing: "start",
                    content: [
                      {
                        type: "button",
                        text: "Delete",
                        iconId: "delete",
                        callback: async () => {
                          // If there's a corresponding combined id state stored, we want to delete that too.
                          const idMatchIndex = floatyBrainsStateRecord[combinedId].findIndex(state => state.id === floatyBrainsList[mainI].id);
                          if (idMatchIndex !== -1){
                            floatyBrainsStateRecord[combinedId].splice(mainI, 1);
                          }
                          floatyBrainsList.splice(mainI, 1);
                          idsList.splice(idI, 1);
                          await updateFloatyPage(combinedId, currentPage);
                          await saveFloatyBrains();
                        }
                      }
                    ]
                  }
                ]
              },
              {
                type: "column",
                alignment: "center",
                spacing: "center",
                content: [
                  {
                    type: "button",
                    iconId: "arrow-up",
                    callback: async () => {
                      if (idsList.length > 1){
                        const indexAbove = idI - 1;
                        if (indexAbove < 0){
                          // For up wraparound, we don't want to swap.
                          // Instead, move current to array end and move the rest up.
                          idsList.push(idsList.shift()!);
                        }
                        else{
                          [idsList[idI], idsList[indexAbove]] = [idsList[indexAbove], idsList[idI]];
                        }
                        await updateFloatyPage(combinedId, currentPage);
                        await saveFloatyBrains();
                        }
                    }
                  },
                  {
                    type: "button",
                    iconId: "arrow-down",
                    callback: async () => {
                      if (idsList.length > 1){
                        const indexBelow = idI + 1;
                        if (indexBelow > idsList.length - 1){
                          // For down wraparound, we don't want to swap.
                          // Instead, move current to array start and move the rest down.
                            idsList.unshift(idsList.pop()!);
                        }
                        else{
                          [idsList[idI], idsList[indexBelow]] = [idsList[indexBelow], idsList[idI]];
                        }
                        await updateFloatyPage(combinedId, currentPage);
                        await saveFloatyBrains();
                      }
                    }
                  },
                ]
              }
            ]
          }
        ]
      }
    );
  }
  return brainPartsList;
}

async function updateFloatyPage(combinedId: string, currentPage: FloatyPage)
{
  if (currentPage === "EnabledEntries"){
    await api.v1.ui.updateParts(
      [
        {
          id: "brainDisplayContainerFloaty", 
          content: [...floatyBrainRebuild(combinedId, currentPage, floatyActiveIdsList)]
        }
      ]
    );
  }
  else if (currentPage === "DisabledEntries"){
    await api.v1.ui.updateParts(
      [
        {
          id: "brainDisplayContainerFloaty", 
          content: [...floatyBrainRebuild(combinedId, currentPage, floatyInactiveIdsList)]
        }
      ]
    );
  }
}

async function floatyBrainsImport(scriptPermission: ScriptPermission, combinedId: string, currentPage: FloatyPage)
{
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  const file = await api.v1.file.prompt({ accept: '.json' });
  if (!file) return;
  
  try {
    const data = JSON.parse(file);
    if (data.fileType){
      if (data.fileType != "floatyBrains"){
        api.v1.ui.toast("Data type is not floatyBrains. Canceling import.", {type: "warning"});
        return;
      }
    }

    // Use these to show Skip/Overwrite option in bulk after traversing imported data.
    let dupeExistingIndexList: number[] = [];
    let dupeImportedIndexList: number[] = [];
    let dupeCount = 0;

    // Compare with existing and check for overwrite.
    const importedList: FloatyBrain[] = data.floatyBrainsList;
    for (let i = 0; i < importedList.length; i++){
      const existingIdIndex = floatyBrainsList.findIndex(existingItem => existingItem.id === importedList[i].id);
      if (existingIdIndex !== -1){
        dupeExistingIndexList.push(existingIdIndex);
        dupeImportedIndexList.push(i);
        dupeCount++;
      }
      else{
        // Primary list should never have stuff that state list doesn't have.
        // So if primary list doesn't have matching id, state record shouldn't either.
        // Thus, we should be able to safely import for both without duplicate ids.
        floatyBrainsList.push(importedList[i]);
        floatyBrainsStateRecord[combinedId].push({id: importedList[i].id, active: importedList[i].active});
        if (importedList[i].active){
          floatyActiveIdsList.push(importedList[i].id);
        }
        else{
          floatyInactiveIdsList.push(importedList[i].id);
        }
      }
    }
    if (dupeCount > 0){
      let dupeNewPartsList: UIPart[] = [];
      let dupeCurrentPartsList: UIPart[] = [];
      for (let i = 0; i < dupeCount; i++){
        const importI = dupeImportedIndexList[i];
        dupeNewPartsList.push(
          {
            type: "container",
            style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
            content: [
              {
                type: "text",
                style: { textAlign: "center" },
                text: `${importedList[importI].entry.name}\n${importedList[importI].id}\n${importedList[importI].entry.content}`
              }
            ]
          }
        );
        const existingI = dupeExistingIndexList[i];
        dupeCurrentPartsList.push(
          {
            type: "container",
            style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
            content: [
              {
                type: "text",
                style: { textAlign: "center" },
                text: `${floatyBrainsList[existingI].entry.name}\n${floatyBrainsList[existingI].id}\n${floatyBrainsList[existingI].entry.content}`
              }
            ]
          }
        );
      }
      
      // Bring up a modal to choose Skip/Overwrite in bulk
      const overwriteCheckModal = await api.v1.ui.modal.open({
        title: "Import Floaty Brains",
        content: [
          {
            type: "row",
            alignment: "center",
            spacing: "center",
            content: [
              {
                type: "text",
                text: "This file contains entries already present (same id) in the current Floaty Brains, would you like to overwrite them?"
              },
            ]
          },
          {
            type: "row",
            alignment: "center",
            spacing: "space-around",
            content: [
              {
                type: "button",
                text: "Skip",
                callback: () => {
                  // Don't need to do anything more. Relevant data has already been imported.
                  overwriteCheckModal.close();
                }
              },
              {
                type: "button",
                text: "Overwrite",
                callback: () => {
                  for (let i = 0; i < dupeCount; i++){
                    const importI = dupeImportedIndexList[i];
                    const existingI = dupeExistingIndexList[i];
                    floatyBrainsList[existingI].active = importedList[importI].active;
                    floatyBrainsList[existingI].entry.name = importedList[importI].entry.name;
                    floatyBrainsList[existingI].entry.content = importedList[importI].entry.content;

                    const stateIndex = floatyBrainsStateRecord[combinedId].findIndex(item => item.id === floatyBrainsList[existingI].id);
                    if (stateIndex !== -1){
                      floatyBrainsStateRecord[combinedId][existingI].active = floatyBrainsList[existingI].active;
                    }
                  }
                  overwriteCheckModal.close();
                }
              },
            ]
          },
          {
            type: "row",
            alignment: "center",
            spacing: "start",
            content: [
              {
                type: "text",
                text: "Same ID"
              },
            ]
          },
          {
            type: "row",
            alignment: "center",
            spacing: "center",
            content: [
              {
                type: "column",
                content: [
                  {
                    type: "text",
                    style: { textAlign: "center" },
                    text: "New"
                  },
                  ...dupeNewPartsList
                ]
              },
              {
                type: "column",
                content: [
                  {
                    type: "text",
                    style: { textAlign: "center" },
                    text: "Current"
                  },
                  ...dupeCurrentPartsList
                ]
              },
            ]
          },
        ]
      });
      overwriteCheckModal.closed.then( async () => {
        await updateFloatyPage(combinedId, currentPage);
      });
    }
    else{
      await updateFloatyPage(combinedId, currentPage);
    }
    api.v1.log(...floatyBrainsList);
    await saveFloatyBrains();
  } catch (e) {
    api.v1.error('Failed to import Floaty Brains:', e);
  }
}

async function floatyBrainsExport(scriptPermission: ScriptPermission)
{
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  if (hasPermission){
    const currentDate = new Date();
    const suggestedName = `AR_FloatyBrains_${currentDate.toLocaleDateString()}_${currentDate.toLocaleTimeString().replace(" ", "_")}.json`;
    const namedData = {
      fileType: "floatyBrains",
      format: CARD_FORMAT,
      floatyBrainsList
    };
    await api.v1.file.save(suggestedName, JSON.stringify(namedData, null, 2));
  }
}

let diaryBrainsRecord: Record<string, BrainConditional[]> = {};
const DIARY_BRAINS_RECORD_KEY = "diaryBrainsRecordKey";
await api.v1.storyStorage.setIfAbsent(DIARY_BRAINS_RECORD_KEY, diaryBrainsRecord);
diaryBrainsRecord = await api.v1.storyStorage.get(DIARY_BRAINS_RECORD_KEY);

type PlanType = "User" | "AI";
type PlanDuration = "Ongoing" | "Limited";

interface ActionPlan {
  name: string,
  content: string,
  startedAtCount: number, // user msg count the plan started at - going below this automatically deletes the plan
  totalTurns: number,
  remainingTurns: number, // turns decrement as user msg count increments beyond starting count
  running: boolean,
  planType: PlanType,
  durationType: PlanDuration
}

const ACTION_PLAN_STANDARD_TURNS: number = 3;

let actionPlansRecord: Record<string, ActionPlan[]> = {};
const ACTION_PLANS_RECORD_KEY = "actionPlansRecordKey";
await api.v1.storyStorage.setIfAbsent(ACTION_PLANS_RECORD_KEY, actionPlansRecord);
actionPlansRecord = await api.v1.storyStorage.get(ACTION_PLANS_RECORD_KEY);

interface ForumPost {
  content: string,
  emotion: Emotion,
  screenName: string,
  id?: string // Post can be a genned reply with no link to a known char id so optional
}

interface ForumOriginalPost extends ForumPost {
  title: string,
  id: string
}

interface ForumThread {
  originalPost: ForumOriginalPost,
  replyList: ForumPost[]
}

