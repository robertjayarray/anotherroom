                }
              },
              {
                type: "button",
                style: { marginTop: 20 },
                text: "Delete",
                iconId: "delete",
                callback: async () => {
                  char.brainsConditional.splice(i, 1);
                  await saveCharList();
                  await reflectCharChangesInChatSettings(char);
                  rebuildBrainParts();
                  await api.v1.ui.updateParts([{id: brainDisplayContainerId, content: [...brainPartsList]}]);
                }
              }
            ]
          }
        );
      }
    }
    rebuildBrainParts();

    return [
      {
        type: "text",
        markdown: true,
        text: "# Brains\n**Additional background info**"
      },
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "button",
            iconId: "sunset",
            callback: async () => {
              const changesMade = await cardBrainImport("fileInput", char);
              if (changesMade){
                await saveCharList();
