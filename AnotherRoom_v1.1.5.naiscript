const SCRIPT_PERMISSION_TYPE_TO_STRING: Record<ScriptPermission, string> = {
  "clipboardWrite": "Write to Clipboard",
  "fileDownload": "File Download",
  "fileInput": "File Input",
  "storyEdit": "Modify Story Content",
  "documentEdit": "Modify Document Content",
  "lorebookEdit": "Modify Lorebook Entries",
  "editorDecorations": "Editor Decorations"
} as const;
async function permissionCheckPassed(scriptPermission: ScriptPermission) : Promise<boolean>
{
  const hasPermission = await api.v1.permissions.has(scriptPermission);
  if (hasPermission){
    return true;
  }
  else{
    const granted = await api.v1.permissions.request(scriptPermission);
    if (granted){
      return true;
    }
    else{
      return false;
    }
  }
}
function permissionRejectedShowWarning(scriptPermission: ScriptPermission)
{
  api.v1.ui.toast(`${SCRIPT_PERMISSION_TYPE_TO_STRING[scriptPermission]} permission required for this operation.`, {type: "warning"});
}

