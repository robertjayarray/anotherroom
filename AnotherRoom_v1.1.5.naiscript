        style: { marginTop: "10px", borderColor: "bg3", color: "textMain", fontWeight: "bold", fontSize: "16px" },
        storageKey: USE_IMAGE_DECO_KEY,
        label: "Use Image Decorations",
        onChange: async (val) => {
          if (val === true){
            await updateEditorImages();
          }
          else{
            clearEditorImages();
          }
          await updateEmotionRule();
        }
      },
      {
        type: "text",
        text: "If the current character has an avatar set, and/or if emojis are set, they will show as editor decorations."
      },
      {
        type: "text",
        text: "Emojis",
        style: { marginTop: "20px", borderColor: "bg3", color: "textMain", fontWeight: "bold", fontSize: "16px" },
      },
      {
        type: "text",
        text: "Import a json file of the 24 emotions with base64 images for emojis"
      },
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "button",
            text: "Import Emojis",
            callback: async () => {
              const file = await api.v1.file.prompt({ accept: '.json' });
              if (!file) return;
              
              try {
                const data = JSON.parse(file);
                for (const emotion of EMOTION_LIST){
                  if (data[emotion]){
                    emojiRef[emotion] = data[emotion];
                  }
                }
                await api.v1.storage.set(EMOJI_REF_KEY, emojiRef);
                await updateEditorImages();
                await updateEmotionRule();
                //api.v1.log(emojiRef);
              } catch (e) {
                api.v1.error('Failed to import emojis:', e);
              }
            }
          },
          {
            type: "button",
            iconId: "delete",
            callback: async () => {
              if (Object.keys(emojiRef).length > 0){
                let modal = await api.v1.ui.modal.open({
                  title: "Delete Emojis?",
                  size: 'small',
                  content: [
                    { type: "text", text: "Are you sure you want to delete the images?" },
                    {
                      type: 'row',
                      style: { marginTop: '16px', gap: '8px', justifyContent: 'flex-end' },
                      content: [
                        { type: 'button', text: 'Cancel', callback: async function() { modal.close(); } },
                        {
                          type: 'button',
                          text: 'Delete',
                          iconId: 'trash',
                          callback: async () => {
                            emojiRef = {};
                            //api.v1.log(emojiRef);
                            await api.v1.storage.set(EMOJI_REF_KEY, emojiRef);
                            clearEditorImages();
                            await updateEditorImages();
                            await updateEmotionRule();
                            modal.close();
                          }
                        }
                      ]
                    }
                  ]
                });
              }
            }
          },
        ]
      },
      {
        type: "checkboxInput",
        style: { marginTop: "10px", borderColor: "bg3", color: "textMain", fontWeight: "bold", fontSize: "16px" },
        storageKey: USE_EMOTIONAL_MODES_KEY,
        label: "Use Emotional Modes",
      },
      {
        type: "text",
        text: "Extra emotion-related influence on Contact behavior. May activate from real-time away or from certain patterns of recent emotions in chat."
      },
    ]
  }),
  api.v1.ui.extension.scriptPanel({
    id: "chatSettingsEdit",
    name: "AR Chat Settings",
    content: [
      {
        type: "container",
        id: "chatSettingsId",
        content: [
          ...getChatSettingsUi()
        ]
      },
    ]
  }),
  api.v1.ui.extension.scriptPanel({
    id: "arGamesPanel",
    name: "AR Games",
    content: [
      {
        type: "container",
        id: "arGamesContainer",
        content: [
          {
            type: "checkboxInput",
            label: "Include Game Stats in Context",
            storageKey: INCLUDE_GAME_STATS_KEY
          },
          /*Gen separate from the rest of it. But optionally include the end result(s) in context as a brain. Something like: 
          Brain Name: Game History
          Brain Content: Rock Paper Scissors: {{user}} won against {{char}} x times, {{user}} lost to {{char}} x times, {{user}} tied with {{char}} x times*/
          {
            type: "button",
            text: "Rock Paper Scissors",
            callback: async () => {
              // Open a modal to play, which also gens (or has a chance to gen?) a short response from the AI after
              //type GameOutcome = "Char" | "User" | "Tie";
              
              const rpsOutcomeDisplayKey = "rpsOutcomeDisplayTempKey";
              const rpsStatsDisplayKey = "rpsStatsDisplayTempKey";
              type RPSChoice = "Rock" | "Paper" | "Scissors";
              const rpsRef: Record<number, RPSChoice> = {
                1: "Rock",
                2: "Paper",
                3: "Scissors"
              } as const;
              async function playRPS(userChoice: RPSChoice) : Promise<void>
              {
                /*
                - Paper and Rock: Paper wins
                - Rock and Scissors: Rock wins
                - Scissors and Paper: Scissors wins
                 */
                let charChoice: RPSChoice = rpsRef[api.v1.random.int(1, 3)];

                // Grug override choice with own. Grug smash.
                if (chatSettings.char!.name === "Grug"){
                  charChoice = "Rock";
                }

                // Formatted for AI seeing it as generation system message.
                let rpsOutcomeContextStr = `${chatSettings.char!.name || ""} chose ${charChoice}. ${chatSettings.user!.name || ""} chose ${userChoice}. `;

                // Formatted for display in the UI.
                let rpsOutcomeDisplayStr = `${chatSettings.char!.name || ""} chose ${charChoice}. ${chatSettings.user!.name || ""} chose ${userChoice}.\n\n ### Outcome\n`;

                let outcomeAlone = "";

                // For unique game record storing/updating.
                const combinedId = chatSettings.char!.id + chatSettings.user!.id;
                if (!gameRecord.RPS[combinedId]){
                  //api.v1.log("no record for this pairing yet, creating one");
                  gameRecord.RPS[combinedId] = {
                    kind: "competitive",
                    displayLabel: "Rock Paper Scissors",
                    charWins: 0,
                    charLosses: 0,
                    userWins: 0,
                    userLosses: 0,
                    ties: 0
                  };
                }

                const currentStats = gameRecord.RPS[combinedId] as CompetitiveStats;

                if (userChoice === charChoice){
                  // it's a tie
                  currentStats.ties++;
                  outcomeAlone = `${userChoice} and ${charChoice} are the same! It's a tie!`;
                }
                else if (
                  (userChoice === "Paper" && charChoice === "Rock") 
                  || (userChoice === "Rock" && charChoice === "Scissors")
                  || (userChoice === "Scissors" && charChoice === "Paper")
                  ){
                  // user wins
                  currentStats.userWins++;
                  currentStats.charLosses++;
                  outcomeAlone = `${userChoice} beats ${charChoice}! ${chatSettings.user!.name || ""} wins!`;
                }
                else if (
                  (charChoice === "Paper" && userChoice === "Rock") 
                  || (charChoice === "Rock" && userChoice === "Scissors")
                  || (charChoice === "Scissors" && userChoice === "Paper")
                  ){
                  // char wins
                  currentStats.charWins++;
                  currentStats.userLosses++;
                  outcomeAlone = `${charChoice} beats ${userChoice}! ${chatSettings.char!.name || ""} wins!`;
                }

                rpsOutcomeContextStr += outcomeAlone;
                rpsOutcomeDisplayStr += outcomeAlone;

                let rpsStatsStr = "";
                const gInstance = gameRecord.RPS[combinedId] as CompetitiveStats;
                rpsStatsStr += "### Stats\n";
                rpsStatsStr += `**${chatSettings.char!.name}**: ${gInstance.charWins} wins, ${gInstance.charLosses} losses`;
                rpsStatsStr += ` | **${chatSettings.user!.name}**: ${gInstance.userWins} wins, ${gInstance.userLosses} losses`;
                rpsStatsStr += ` | **Shared**: ${gInstance.ties} ties`;

                await api.v1.ui.updateParts([
                  {
                    id: "gameReactionArea", 
                    content: [
                      { 
                        type: 'text', 
                        text: `${chatSettings.char!.name} is typing...`, 
                        style: { marginTop: '12px', opacity: 0.5, fontStyle: 'italic' }
                      }
                    ]
                  }
                ]);
                const reaction: Reaction = await genGameReaction(chatSettings.char!, chatSettings.user!, "RPS", rpsOutcomeContextStr);
                await api.v1.tempStorage.set(rpsOutcomeDisplayKey, rpsOutcomeDisplayStr);
                await api.v1.tempStorage.set(rpsStatsDisplayKey, rpsStatsStr);
                await api.v1.storage.set(GAME_RECORD_KEY, gameRecord);
                await api.v1.ui.updateParts([
                  {
                    id: "gameReactionArea", 
                    content: [
                      {
                        type: "row",
                        style: { display: "flex", flexDirection: "row", flexWrap: "wrap", gap: "5px" },
                        alignment: "center",
                        content: [
                          reaction.ui,
                          {
                            type: "button",
                            iconId: "plus",
                            callback: async () => {
                              // Optionally inject a "fake" user/contact messages.
                              // These correspond to user and contact choice, outcome, and contact reaction message.
                              // This way user can optionally have continuity between bringing up playing in the chat
                              // and what the exact game sequence looks like.
                              const userChoiceForAppend = `*${chatSettings.user!.name || ""} chooses ${userChoice}.*`;
                              await api.v1.document.appendParagraph(
                                {
                                  text: userChoiceForAppend,
                                  source: "instruction",
                                }
                              );
                              await api.v1.document.appendParagraphs([
                                { text: `${chatSettings.char!.name}: *${chatSettings.char!.name || ""} chooses ${charChoice}. ${outcomeAlone}*`},
                                { text: `    ${reaction.text}`},
                                { text: `  Emotion: ${reaction.emotion}`},
                              ]);
                              await updateEditorImages();
                              gameModal.close();
                            }
                          }
                        ]
                      }
                      ]
                  }
                ]);
                await setUiPartVisState("resetGameStatsIdRPS", true);
              }

              if (!chatSettings.char || !chatSettings.user){
                api.v1.ui.toast("Must have a Contact and User set to play.", {type: "warning"});
                return;
              }

              async function disableBtnChoices(disabled: boolean){
                await api.v1.ui.updateParts([
                  {id: "rockBtnRPS", disabled: disabled},
                  {id: "paperBtnRPS", disabled: disabled},
                  {id: "scissorsBtnRPS", disabled: disabled},
                ]);
              }

              // Clear before opening modal.
              await api.v1.tempStorage.set(rpsOutcomeDisplayKey, "");
              await api.v1.tempStorage.set(rpsStatsDisplayKey, "");

              let gameModal = await api.v1.ui.modal.open({
                title: "Rock Paper Scissors",
                content: [
                  {
                    type: "container",
                    style: { overflow: "scroll", maxHeight: "70%" },
                    content: [
                      {
                        type: "row",
                        alignment: "center",
                        spacing: "center",
                        content: [
                          {
                            type: "text",
                            markdown: true,
                            text: `## ${chatSettings.char.name || ""} vs. ${chatSettings.user.name || ""}`
                          },
                        ]
                      },
                      {
                        type: "row",
                        alignment: "center",
                        spacing: "center",
                        content: [
                          {
                            type: "button",
                            id: "rockBtnRPS",
                            text: "Rock",
                            callback: async () => {
                              await disableBtnChoices(true);
                              await playRPS("Rock");
                              await disableBtnChoices(false);
                            },
                          },
                          {
                            type: "button",
                            id: "paperBtnRPS",
                            text: "Paper",
                            callback: async () => {
                              await disableBtnChoices(true);
                              await playRPS("Paper");
                              await disableBtnChoices(false);
                            },
                          },
                          {
                            type: "button",
                            id: "scissorsBtnRPS",
                            text: "Scissors",
                            callback: async () => {
                              await disableBtnChoices(true);
                              await playRPS("Scissors");
                              await disableBtnChoices(false);
                            },
                          },
                        ]
                      },
                      {
                        type: "row",
                        alignment: "center",
                        spacing: "center",
                        content: [
                          {
                            type: "text",
                            style: { textAlign: "center" },
                            markdown: true,
                            text: `{{temp:${rpsOutcomeDisplayKey}}}`,
                          },
                        ]
                      },
                      {
                        type: "row",
                        alignment: "center",
                        spacing: "center",
                        content: [
                          {
                            type: "text",
                            style: { textAlign: "center" },
                            markdown: true,
                            text: `{{temp:${rpsStatsDisplayKey}}}`
                          }
                        ]
                      },
                    ]
                  },
                  {
                    type: "row",
                    alignment: "center",
                    spacing: "center",
                    content: [
                      {
                        type: "container",
                        id: "gameReactionArea",
                        style: { marginTop: '12px', marginBottom: '4px', minWidth: "90%" }, 
                        content: [
                          { 
                            type: 'text', 
                            text: "", 
                            style: { marginTop: '12px', opacity: 0.5, fontStyle: 'italic' }
                          },
                        ]
                      },
                    ]
                  },
                  {
                    type: "row",
                    alignment: "center",
                    spacing: "center",
                    content: [
                      ...getResetStatsUi("RPS")
                    ]
                  }
                  /*
                  {
                    type: "row",
                    alignment: "center",
                    spacing: "center",
                    content: [
                      {
                        type: "button",
                        text: "Reset Stats",
                        callback: async () => {
                          const combinedId = chatSettings.char!.id + chatSettings.user!.id;
                          if (!gameRecord.RPS[combinedId]){
                            api.v1.ui.toast(`${chatSettings.char!.name} and ${chatSettings.user!.name} have no history to reset.`, {type: "warning"});
                            return;
                          }
                          let confirmationModal = await api.v1.ui.modal.open({
                            title: "Reset Stats?",
                            size: 'small',
                            content: [
                              { type: "text", text: `Are you sure you want to Reset ${gameRecord.RPS[combinedId].displayLabel} Stats for ${chatSettings.char!.name} and ${chatSettings.user!.name}?` },
                              {
                                type: 'row',
                                style: { marginTop: '16px', gap: '8px', justifyContent: 'flex-end' },
                                content: [
                                  { type: 'button', text: 'Cancel', callback: async function() { confirmationModal.close(); } },
                                  {
                                    type: "button",
                                    text: "Reset Stats",
                                    callback: async () => {
                                      delete gameRecord.RPS[combinedId];
                                      await api.v1.storage.set(GAME_RECORD_KEY, gameRecord);
                                      confirmationModal.close();
                                      gameModal.close();
                                    }
                                  }
                                ]
                              }
                            ]
                          });
                        }
                      }
                    ]
                  }
                  */
                ],
                size: "medium"
              });
            }
          },
          {
            type: "button",
            text: "Number Guess",
            callback: async () => {
              if (!chatSettings.char || !chatSettings.user){
                api.v1.ui.toast("Must have a Contact and User set to play.", {type: "warning"});
                return;
              }

              let submitRunning = false;

              const introStr = `*${chatSettings.user!.name} is locked in a room with ${chatSettings.char.name}. They have to guess the correct number, from 1 to 100, to escape. Each round, they both guess and then find out how close they are. The better they use information from both guesses, the faster they can win, together.*`;

              const gameReactionAreaDefault: UIPart = { 
                type: 'text', 
                text: "", 
                style: { marginTop: '12px', opacity: 0.5, fontStyle: 'italic' }
              };

              const guesserOutcomeDisplayKey = "guesserOutcomeDisplayTempKey";

              const min = 1;
              const max = 100;
              let numberToGuess: number = api.v1.random.int(min, max);
              let turnsTakenToComplete = 0;

              // As guesses are done, we record them with the result if game wasn't won.
              // The AI then uses this information for future guesses it makes.
              type Dir = "Lower" | "Higher";
              interface GuessHistory {
                guess: number,
                outcome: Dir
              }
              let guessHistoryList: GuessHistory[] = [];

              async function resetForNewRound() : Promise<void>
              {
                numberToGuess = api.v1.random.int(min, max);
                turnsTakenToComplete = 0;
                guessHistoryList.length = 0;
                await api.v1.tempStorage.set(guesserOutcomeDisplayKey, "");
                await api.v1.ui.updateParts([
                    {
                      id: "gameReactionArea", 
                      content: [gameReactionAreaDefault]
                    }
                ]);
              }

              function getAIGuess() : number
              {
                /*
                How this needs to work as reasoning. Something like:
                - Initial possibility space is the starting range (e.g. 1-100)
                - If, for example, we have a history of 30 and Lower, this means the solution must be 1-29
                - If we then encounter a number higher than that as another historical guess, we ignore it
                */
                let newMin = min;
                let newMax = max;
                for (const hist of guessHistoryList){
                  if (hist.outcome == "Lower" && hist.guess - 1 < newMax){
                    newMax = hist.guess - 1;
                  }
                  else if (hist.outcome == "Higher" && hist.guess + 1 > newMin){
                    newMin = hist.guess + 1;
                  }
                }

                return api.v1.random.int(newMin, newMax);
              }

              async function checkNumberGuess(userGuess: number) : Promise<void>
              {
                let won = false;
                submitRunning = true;

                const aiGuess = getAIGuess();

                turnsTakenToComplete++;

                // To avoid slowing down guessing too much / having too frequent AI calls for API limits,
                // we do a chance of response for higher/lower. Win state guarantees a response.
                const chanceOfResponse: number = api.v1.random.int(1, 5);
                //api.v1.log(chanceOfResponse);
                let doResponse: boolean = false;
                if (chanceOfResponse == 1){
                  doResponse = true;
                }

                let gameOutcomeContextStr = `*${chatSettings.user!.name || ""} guessed ${userGuess.toString()}. ${chatSettings.char!.name || ""} guessed ${aiGuess.toString()}.`;
                let gameOutcomeDisplayStr = "*";
                if (numberToGuess == userGuess || numberToGuess == aiGuess){
                  // win state
                  won = true;
                  gameOutcomeContextStr += ` ${numberToGuess} is correct. ${chatSettings.char!.name} and ${chatSettings.user!.name} win! The room unlocks with a hiss. A sign displays a message, indicating they can leave or play again.*`;
                  gameOutcomeDisplayStr += `${numberToGuess} is correct! ${chatSettings.char!.name} and ${chatSettings.user!.name} win! The room is unlocked. They can leave now or play again.*`;
                  doResponse = true;

                  try{
                    // For unique game record storing/updating.
                    
                    // As we may be pulling from existing storage where RPS was the only game,
                    // we need to make sure the new game exists in record and create it if not.
                    if (!gameRecord.NumberGuess){
                      gameRecord.NumberGuess = {};
                    }

                    const combinedId = chatSettings.char!.id + chatSettings.user!.id;
                    if (!gameRecord.NumberGuess[combinedId]){
                      api.v1.log("no record for this pairing yet, creating one");
                      gameRecord.NumberGuess[combinedId] = {
                        kind: "cooperative",
                        displayLabel: "Number Guess",
                        sharedWins: [turnsTakenToComplete]
                      };
                    }
                    else{
                      const currentStats = gameRecord.NumberGuess[combinedId] as CoopStats;
                      currentStats.sharedWins.push(turnsTakenToComplete);
                    }
                    await api.v1.storage.set(GAME_RECORD_KEY, gameRecord);
                  }catch (e){
                    api.v1.log(e);
                  }
                }
                else{
                  if (numberToGuess > userGuess){
                    // higher
                    gameOutcomeContextStr += ` The correct number is higher than what ${chatSettings.user!.name} guessed `;
                    gameOutcomeDisplayStr += `Higher than ${userGuess}.`;
                    guessHistoryList.push({guess: userGuess, outcome: "Higher"});
                  }
                  else if (numberToGuess < userGuess){
                    // lower
                    gameOutcomeContextStr += ` The correct number is lower than what ${chatSettings.user!.name} guessed `;
                    gameOutcomeDisplayStr += `Lower than ${userGuess}.`;
                    guessHistoryList.push({guess: userGuess, outcome: "Lower"});
                  }

                  if (numberToGuess > aiGuess){
                    // higher
                    gameOutcomeContextStr += ` and higher than what ${chatSettings.char!.name} guessed.*`;
                    gameOutcomeDisplayStr += ` Higher than ${aiGuess}.*`;
                    guessHistoryList.push({guess: aiGuess, outcome: "Higher"});
                  }
                  else if (numberToGuess < aiGuess){
                    // lower
                    gameOutcomeContextStr += ` and lower than what ${chatSettings.char!.name} guessed.*`;
                    gameOutcomeDisplayStr += ` Lower than ${aiGuess}.*`;
                    guessHistoryList.push({guess: aiGuess, outcome: "Lower"});
                  }
                }
                
                if (doResponse){
                  await api.v1.ui.updateParts([
                    {
                      id: "gameReactionArea", 
                      content: [
                        { 
                          type: 'text', 
                          text: `${chatSettings.char!.name} is typing...`, 
                          style: { marginTop: '12px', opacity: 0.5, fontStyle: 'italic' }
                        }
                      ]
                    }
                  ]);
                  
                  const reaction: Reaction = await genGameReaction(chatSettings.char!, chatSettings.user!, "NumberGuess", introStr + " " + gameOutcomeContextStr);
                  
                  await api.v1.ui.updateParts([
                    {
                      id: "gameReactionArea", 
                      content: [
                        {
                          type: "row",
                          style: { display: "flex", flexDirection: "row", flexWrap: "wrap", gap: "5px" },
                          alignment: "center",
                          content: [
                            reaction.ui,
                          ]
                        }
                        ]
                    }
                  ]);
                }
                else{
                  const fakeBubble: UIPart = buildMessageBubble(
                    chatSettings.char!.name, aiGuess.toString(), "neutral", 'contact', chatSettings.char!,
                    0, 0
                  );
                  await api.v1.ui.updateParts([
                    {
                      id: "gameReactionArea", 
                      content: [
                        {
                          type: "row",
                          style: { display: "flex", flexDirection: "row", flexWrap: "wrap", gap: "5px" },
                          alignment: "center",
                          content: [
                            fakeBubble,
                          ]
                        }
                        ]
                    }
                  ]);
                }
                await api.v1.tempStorage.set(guesserOutcomeDisplayKey, gameOutcomeDisplayStr);
                if (won){ // time it here so it's after ending AI gen
                  await setUiPartVisState("playAgainBtn", true);
                  await setUiPartVisState("resetGameStatsIdNumberGuess", true);
                }
                submitRunning = false;
              }

              // Clear before opening modal.
              await api.v1.tempStorage.set(guesserOutcomeDisplayKey, "");
              
              let gameModal = await api.v1.ui.modal.open({
                title: "Number Guess",
                content: [
                  {
                    type: "container",
                    style: { overflow: "scroll", maxHeight: "70%" },
                    content: [
                      {
                        type: "button",
                        id: "playAgainBtn",
                        style: { display: getVisState(false) },
                        text: "Play Again",
                        callback: async () => {
                          await setUiPartVisState("playAgainBtn", false);
                          await resetForNewRound();
                        }
                      },
                      {
                        type: "text",
                        markdown: true,
                        text: introStr
                      },
                      {
                        type: "row",
                        alignment: "center",
                        spacing: "start",
                        content: [
                          {
                            type: "numberInput",
                            placeholder: "Press enter to submit",
                            label: "Guess",
                            onSubmit: async (val) => {
                              // Only do the check if it's not currently checking.
                              // As a check can involve waiting for a generation, we don't want overlapping submits.
                              if (!submitRunning){
                                await checkNumberGuess(val);
                              }
                            }
                          },
                        ]
                      },
                      {
                        type: "row",
                        alignment: "center",
                        spacing: "start",
                        content: [
                          {
                            type: "text",
                            style: { textAlign: "center" },
                            markdown: true,
                            text: `{{temp:${guesserOutcomeDisplayKey}}}`,
                          },
                        ]
                      },
                    ]
                  },
                  {
                    type: "row",
                    alignment: "center",
                    spacing: "center",
                    content: [
                      {
                        type: "container",
                        id: "gameReactionArea",
                        style: { marginTop: '12px', marginBottom: '4px', minWidth: "90%" }, 
                        content: [
                          gameReactionAreaDefault
                        ]
                      },
                    ]
                  },
                  {
                    type: "row",
                    alignment: "center",
                    spacing: "center",
                    content: [
                      ...getResetStatsUi("NumberGuess")
                    ]
                  }
                ]
              });
            }
          },
          {
            type: "button",
            style: { display: getVisState(false) },
            text: "Blackjack",
            callback: async () => {
              await openBlackjack();
            }
          }
        ]
      },
    ]
  }),
  {
    type: "toolbarButton",
    id: "arRememberMeBtnId",
    text: `AR ${REMEMBER_ME_FEATURE_NAME}`,
    callback: async () => {
      await openRememberMeUi();
    }
  },
  ...getDiariesAndBrainsSummoner(diariesAndBrainsSummonerType)
]);

api.v1.hooks.register("onScriptsLoaded", async () => {
  await updateEditorImages();
