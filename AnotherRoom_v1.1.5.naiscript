const CARD_FORMAT: string = "AnotherRoom @ Triplis @ 1.0.2";

type CardType = "contact" | "user" | "scenario";

type Card = Character | User | Scenario;

interface Character {
  cardType: CardType;
  format: string;
  id: string;
  author: string;
  name: string;
  alias?: string;
  description?: string;
  species?: string;
  gender?: string;
  pronouns?: string;
  persona?: string;
  appearance?: string;
  greeting?: string;
  greetingEmotion?: Emotion;
  defaultIntimacy: Intimacy;
  defaultStyle: Style;
  cjk?: boolean;
  tags?: string;
  avatar?: string;
  emotions: Record<Emotion, string>;
  exampleChats: ExampleChat[];
  brains: BrainEntry[];
  brainsConditional: BrainComplexConditional[];
  schedule?: Record<Day, ScheduleEvent[]>;
}

interface User {
  cardType: CardType;
  format: string;
  id: string;
  author: string;
  name: string;
  description?: string;
  species?: string;
  gender?: string;
  pronouns?: string;
  persona?: string;
  appearance?: string;
  tags?: string;
  brains: BrainEntry[];
  brainsConditional: BrainComplexConditional[];
}

interface Scenario {
