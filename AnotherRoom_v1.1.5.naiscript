function getCharListing() : UIPart[]
{
  function getDeleteBtnUi(itemIndex: number) : UIPart[]
  {
    return [
      {
        type: "button",
        iconId: "delete",
        callback: async () => {
          await confirmDeleteCharacter(charList[itemIndex], itemIndex);
        }
      },
    ];
  }

  let partsList: UIPart[] = [];
  for (let i = 0; i < charList.length; i++)
  {
    const card = charList[i];
    partsList.push(
      {
        type: "row",
        spacing: "start",
        content: [
          {
            type: "button",
            iconId: "sunrise",
            callback: async () => {
              await exportCharacter("fileDownload", card);
            }
          },
          {
            type: "button",
            text: card.alias || card.name,
            callback: async () => {
              const modal = await api.v1.ui.modal.open({
                title: "Character",
                content: [
                  ...getCharUiModal(card)
                ],
                size: "large",
              });
              modal.closed.then( async () => {
                await updateCharListingUi();
              });
            }
          },
          ...getDeleteBtnUi(i)
        ]
      }
    );
  }
  return partsList;
}

async function updateCharListingUi()
{
  await api.v1.ui.updateParts([{id: "charListingId", content: [...getCharListing()]}]);
}

async function confirmDeleteUser(user: User, itemIndex: number): Promise<void> {
  let modal: any;
  modal = await api.v1.ui.modal.open({
    title: 'Delete Persona?',
    size: 'small',
    content: [
      { type: 'text', text: 'Are you sure you want to delete "' + user.name + '"?' },
      {
        type: 'row',
        style: { marginTop: '16px', gap: '8px', justifyContent: 'flex-end' },
        content: [
          { type: 'button', text: 'Cancel', callback: async function() { modal.close(); } },
          {
            type: 'button',
            text: 'Delete',
            iconId: 'trash',
            callback: async () => {
              if (userList[itemIndex].id === chatSettings.user?.id){
                chatSettings.user = undefined;
                await saveChatSettings();
                await updateChatSettingsUi();
              }
              userList.splice(itemIndex, 1);
              await saveUserList();
              await updateUserListingUi();
              modal.close();
            }
          }
        ]
      }
    ]
  });
}

