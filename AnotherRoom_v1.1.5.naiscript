continuityCreationRecord = await api.v1.storyStorage.get(CONTINUITY_CREATION_RECORD_KEY);

type DiaryPage = "DiaryEntries" | "CurrentPlans" | "ForumThreads" | "ContinuityCreation" | "EmotionalMemory";

async function saveActionPlans()
{
  await api.v1.storyStorage.set(ACTION_PLANS_RECORD_KEY, actionPlansRecord);
}

async function saveForumThreads()
{
  await api.v1.storyStorage.set(FORUM_THREADS_RECORD_KEY, forumThreadsRecord);
}

async function updateForumThread(replyList: ForumPost[])
{
  await api.v1.ui.updateParts(
    [
      {
        id: "replyDisplayContainer", 
        content: [...forumReplyRebuild(replyList)]
      }
    ]
  );
}

function forumReplyRebuild(replyList: ForumPost[]) : UIPart[]
{
  let replyBubbleList: UIPart[] = [];
  for (let i = 0; i < replyList.length; i++){
    let msgBubble: UIPart;
    let avatar;
    const charIndex = charList.findIndex(char => char.id === replyList[i].id);
    if (charIndex !== -1){
      if (Object.keys(charList[charIndex].emotions).length === 24){
        avatar = charList[charIndex].emotions[replyList[i].emotion];
      }
      else if (charList[charIndex].avatar){
        avatar = charList[charIndex].avatar;
      }
    }
    msgBubble = buildMessageBubbleForPost(
      replyList[i].screenName, 
      replyList[i].content, 
      replyList[i].emotion,
      avatar
    );
    if (i === replyList.length - 1){
      replyBubbleList.push(
        {
          type: "row",
          alignment: "center",
          spacing: "start",
          content: [
            msgBubble,
            {
              type: "button",
              iconId: "delete",
              callback: async () => {
                replyList.splice(i, 1);
                await saveForumThreads();
                await updateForumThread(replyList);
              }
            }
          ]
        }
      );
    }
    else{
      replyBubbleList.push(msgBubble);
    }
  }
  return replyBubbleList;
}

function getRandUnusedCharAsIndex() : number
{
  // If there's more than one character stored, that means we can have a chance of using it as a forum responder.
  if (charList.length > 1){
    const minIndex = 0;
    const maxIndex = charList.length - 1;
    let randIndex = api.v1.random.int(minIndex, maxIndex);
    if (charList[randIndex].id === chatSettings.char!.id){
      // Don't use the current character as a responder if random lands on them - skip them.
      if (randIndex === minIndex){
        randIndex++;
      }
      else if (randIndex === maxIndex){
        randIndex--;
      }
      else{
        randIndex--;
      }
    }
    return randIndex;
  }
  return -1;
}

/**
 * Extract the text after a specified label, e.g. Title: Hello! should give "Hello"
 */
function getMatchInText(label: string, text: string)
{
  const reggie = new RegExp(`(?<=${label}:\\s)([^\\n]+)`, "i");
  const match = text.match(reggie);
  if (match){
    return match[1];
  }
  else{
    return "";
  }
}

/**
 * Turn "Hello! I was going to " into "Hello!"
 */
function trimUnfinishedSentence(text: string) : string
{
  if (text.endsWith(".") || text.endsWith("!") || text.endsWith("?")){
    return text;
  }
  const lastPeriod = text.lastIndexOf(".");
  const lastExclamationMark = text.lastIndexOf("!");
  const lastQuestionMark = text.lastIndexOf("?");
  const highest = Math.max(lastPeriod, lastExclamationMark, lastQuestionMark);
  return text.substring(0, highest + 1);
}

function buildForumReplySystemPrompt(character: Character) : string
{
  let prompt: string = "";
  prompt += character.name + '\n';
  prompt += 'Type: contact\n';
  if (character.gender && character.gender.trim()) prompt += formatField('Gender', character.gender);
  if (character.pronouns && character.pronouns.trim()) prompt += formatField('Pronouns', character.pronouns);
  if (character.species && character.species.trim()) prompt += formatField('Species', character.species);
  if (character.persona && character.persona.trim()) prompt += formatField('Personality', character.persona);
  if (character.appearance && character.appearance.trim()) prompt += formatField('Appearance', character.appearance);

  if (character.tags && character.tags.trim()) prompt += 'Categories: ' + character.tags.trim() + '\n';

  if (character.exampleChats.length > 0) {
    prompt += 'Example quotes:\n';
    for (let ecIdx = 0; ecIdx < character.exampleChats.length; ecIdx++) {
      const ec = character.exampleChats[ecIdx];
      prompt += (ecIdx + 1) + '.\n';
      for (let msgIdx = 0; msgIdx < ec.messages.length; msgIdx++) {
        const msg = ec.messages[msgIdx];
        const senderName = msg.isContact ? character.name : ec.userName;
        const lines = msg.text.split('\n');
        prompt += '\u2002' + senderName + ': ' + lines[0] + '\n';
        for (let li = 1; li < lines.length; li++) {
          prompt += '\u2002    ' + lines[li] + '\n';
        }
        if (msg.isContact && msg.emotion) {
          prompt += '\u2002  Emotion: ' + msg.emotion + '\n';
        }
      }
    }
  }

  const allBrains: BrainEntry[] = [];
  if (character.brains) {
    for (let bi = 0; bi < character.brains.length; bi++) allBrains.push(character.brains[bi]);
  }

  // If the picked character has diary entries from chatting with the current user, we include those.
  // The aim here is if, for example, they have an entry referencing User by name
  //  and the forum OP also mentions same User by name,
  // then the responding char may make the connection and acknowledge this in their reply.
  // (If the AI can pick up on it properly. Needs testing to ensure it's worth doing.)
  const combinedIdOfPicked = character.id + chatSettings.user!.id;
  if (diaryBrainsRecord[combinedIdOfPicked]){
    for (let bi = 0; bi < diaryBrainsRecord[combinedIdOfPicked].length; bi++) {
      allBrains.push(
        {
          name: diaryBrainsRecord[combinedIdOfPicked][bi].name,
          content: diaryBrainsRecord[combinedIdOfPicked][bi].content
        }
      );
    }
  }

  for (let bi = 0; bi < allBrains.length; bi++) {
    prompt += '----\n' + allBrains[bi].name + '\n' + allBrains[bi].content.trim() + '\n';
  }

  prompt = replaceMacros(prompt, character!.name, chatSettings.user!.name);

  return prompt;
}

async function getWithStoryGen(withStory: boolean, messages: Message[], genParams: GenerationParams)
  : Promise<GenerationResponse>
{
  if (withStory){
    return await api.v1.generateWithStory( 
      messages,
      genParams
    );
  }
  else{
    return await api.v1.generate( 
      messages,
      genParams
    );
  }
}

async function genForumReply(threadSoFar: string, threadIndex: number, combinedId: string) : Promise<void>
{
  let prompt = "AetherRoom\n----\n";

  let withStory = false;
  let usingPremade = false;
  let namePrepend = "";

  const existingCharIndex = getRandUnusedCharAsIndex();
  api.v1.log(existingCharIndex);
  if (existingCharIndex !== -1){
    // We can use this as character who replies to forum post, adding them to sys prompt.
    // For randomness sake and especially since user may have few other chars existing,
    // we should probably still have it be a random chance of choosing them, not guaranteed.
    //const randRoll = 1;
    const randRoll = api.v1.random.int(1, 3);
    api.v1.log(`randRoll: ${randRoll.toString()}`);
    if (randRoll === 1){
      // use char
      usingPremade = true;
      const character = charList[existingCharIndex];
      prompt += buildForumReplySystemPrompt(character);
      namePrepend += `${character.name}\n`;
    }
  }
  if (!usingPremade){
    // Possibly use OP to reply, if there have been enough replies already.
    if (forumThreadsRecord[combinedId][threadIndex].replyList.length > 2){
      const randRoll = api.v1.random.int(1, 4);
      if (randRoll === 1){
        withStory = true;
        usingPremade = true;
        prompt += buildForumReplySystemPrompt(chatSettings.char!);
        namePrepend += `${chatSettings.char!.name}\n`;
      }
    }
    if (!withStory){
      // use a randomly generated character
      const randomName = getRandomNameFull();

      prompt += randomName + '\n';
      prompt += 'Type: contact\n';

      namePrepend += `${randomName}\n`;
    }
  }

  threadSoFar += namePrepend;

  api.v1.log(`SYSTEM PROMPT: ${prompt}`);
  api.v1.log(`THREAD SO FAR: ${threadSoFar}`);

  const replyResponseLengthPossible: string[] = ["short", "medium", "long", "very long"];
  const responseLengthIndex = api.v1.random.int(0, replyResponseLengthPossible.length - 1);
  const responseLength = replyResponseLengthPossible[responseLengthIndex];
  api.v1.log(`RESPONSE LENGTH: ${responseLength}`);

  const messages: Message[] = [
    { role: "system", content: prompt },
    { role: "assistant", content: threadSoFar },
    { role: "system", content: `[ Style: forum reply, thread comment; Response length: ${responseLength} ]` },
  ] as const;
  const genParams: GenerationParams = { 
    model: "xialong-v1", 
    max_tokens: 400, 
    temperature: 0.85, 
    top_p: 0.95, 
    top_k: 250, 
    min_p: 0.0 
  } as const;
  const response = await getWithStoryGen(withStory, messages, genParams);
  let text = response.choices[0].text;
  if (text.startsWith("====\n")){
    text = text.replace("====\n", "");
  }
  text = namePrepend + text;
  //text += response.choices[0].text;
  api.v1.log(`RESPONSE: ${text}`);

  // In theory, a post should follow a pattern like:
  /**
   * Name
   * Body (maybe multi-line esp if I factor Response Length into the prompt in the future)
   * Emotion:
   * So I can assume:
   *  - Name should always be on first line
   *  - Body should show up as one or more lines with subsequent ones indented
   *  - Emotion:
   * So I should be able to do it this way:
   *  - Split into a list
   *  - [0] = name
   *  - look for index matching "Emotion:" includes
   *  - Set content to everything from [1] to [index right before emotion index]
   *  - Get extracted emotion via regex
   * I can probably use something like this for the original parseBody function too to make it more flexible
   */

  function parseReply(text: string)
  {
    const asList = text.split("\n");

    let name = asList[0];

    let content = "";

    // Make sure first line is actually as expected. AI might have done UserName:
    const matchColonName = asList[0].match(/([^:]+)(?=:)/);
    if (matchColonName){
      const [before, after] = asList[0].split(":");
      name = before;
      content += after;
    }

    let emotion: Emotion = "neutral";
    const indexOfEmotion = asList.findIndex(str => str.includes("Emotion:"));
    if (indexOfEmotion !== -1){
      content += asList.slice(1, indexOfEmotion).join("\n");
      
      content = trimUnfinishedSentence(content);

      const matchEmotion = asList[indexOfEmotion].match(/(?<=Emotion:\s)(\b\w+)/g);
      if (matchEmotion){
        emotion = matchEmotion[0];
      }
    }
    return { name: name, content: content, emotion: emotion };
  }

  const replyBody = parseReply(text);

  let replyId = "";
  // Contacts need their id stored, so their message bubble can include avatar if relevant.
  if (withStory){
    replyId = chatSettings.char!.id;
  }
  else if (!withStory && usingPremade){
    replyId = charList[existingCharIndex].id;
  }

  const newPost: ForumPost = {
    screenName: replyBody.name,
    content: replyBody.content,
    emotion: replyBody.emotion,
    id: replyId
  };

  forumThreadsRecord[combinedId][threadIndex].replyList.push(newPost);
  await saveForumThreads();
  await updateForumThread(forumThreadsRecord[combinedId][threadIndex].replyList);
}

function getToggleButtonStyle(on: boolean)
{
  if (on){
    return { background: "textHeadings", color: "bg0" };
  }
  else{
    return { background: "bg3", color: "textMain" };
  }
}

function getPlanDurationAsState(planDuration: PlanDuration)
{
  if (!planDuration){
    return false;
  }
  if (planDuration === "Limited"){
    return false;
  }
  else if (planDuration === "Ongoing"){
    return true;
  }
  return false;
}

