const CHARACTER_LIST_KEY = "characterListKey";
// This is not C++. We use function to make sure it's a new object rather than a reference to const template.
// Who would do a thing like that? Not me, that's who. Surely never.
function createCharTemplate(): Character {
  return {
    cardType: "contact",
    format: CARD_FORMAT,
    id: api.v1.uuid(),
    author: defaultAuthorUsersetting || DEFAULT_AUTHOR_NAME,
    name: "New Character",
    emotions: {},
    exampleChats: [],
    defaultIntimacy: "stranger",
    defaultStyle: "chat",
    brains: [],
    brainsConditional: []
  };
}
let charList: Character[] = [];
await api.v1.storage.setIfAbsent(CHARACTER_LIST_KEY, charList);
charList = await api.v1.storage.get(CHARACTER_LIST_KEY);

async function saveCharList()
{
  await api.v1.storage.set(CHARACTER_LIST_KEY, charList);
}

async function reflectCharChangesInChatSettings(char: Character) : Promise<void>
{
  // We do this to avoid annoying situations where user changes something about a char/user/scenario
  // that is currently set, but the user has to reselect it for the changes to reflect in chatSettings.
  if (!chatSettings.char){
    return;
  }
  if (char.id === chatSettings.char.id){
    chatSettings.char = char;
    await saveChatSettings();
  }
}

async function importCharacter(scriptPermission: ScriptPermission): Promise<void> {
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  
  const file = await api.v1.file.prompt({ accept: '.json' });
  if (!file) return;

  try {
    const data = JSON.parse(file);
    if (data.cardType){
      if (data.cardType != "contact"){
        api.v1.ui.toast("Card type is not contact. Canceling import.", {type: "warning"});
        return;
      }
    }
    const newChar = createCharTemplate();
    newChar.id = data.id || api.v1.uuid();
    const existingId = charList.findIndex(obj => obj.id === newChar.id);
    if (existingId != -1){
      api.v1.ui.toast("A Contact with the same id already exists. Canceling import.", {type: "warning"});
      return;
    }
    newChar.author = data.author || DEFAULT_AUTHOR_NAME;
    newChar.name = data.name || 'Imported Character';
    newChar.alias = data.alias || "";
    newChar.description = data.description;
    newChar.gender = data.gndr || data.gender;
    newChar.pronouns = data.pronouns;
    newChar.species = data.species;
    newChar.tags = data.tags;
    newChar.persona = data.persona;
    newChar.appearance = data.appearance;
    newChar.greeting = data.greeting;
    newChar.greetingEmotion = data.greetingEmotion;
    newChar.defaultIntimacy = data.relationship || 'stranger';
    newChar.defaultStyle = data.style || 'chat';
    newChar.cjk = data.cjk;
    if (data.brains && Array.isArray(data.brains)) newChar.brains = data.brains;
    if (data.brainsConditional && Array.isArray(data.brainsConditional)){
      newChar.brainsConditional = data.brainsConditional;
    }

    // Import avatar if present (base64 data URL)
    if (data.avatarUri && typeof data.avatarUri === 'string' && data.avatarUri.startsWith('data:')) {
      newChar.avatar = data.avatarUri;
    }

    // Import emotion images if present
    if (data.emotions && typeof data.emotions === 'object') {
      const emotionNames = Object.keys(data.emotions);
      for (let i = 0; i < emotionNames.length; i++) {
        const emotionName = emotionNames[i];
        const emotionData = data.emotions[emotionName];
        if (emotionData && typeof emotionData === 'string' && emotionData.startsWith('data:')) {
          newChar.emotions[emotionName] = emotionData;
        }
      }
    }

    newChar.schedule = {
      Daily: [],
      Monday: [],
      Tuesday: [],
      Wednesday: [],
      Thursday: [],
      Friday: [],
      Saturday: [],
      Sunday: []
    }

    if (data.schedule && typeof data.schedule === 'object') {
      for (const day of DAY_LIST){
        newChar.schedule[day] = data.schedule[day];
      }
    }

    if (data.exampleMessages && Array.isArray(data.exampleMessages)) {
      newChar.exampleChats = [];
      for (let i = 0; i < data.exampleMessages.length; i++) {
        const ec = data.exampleMessages[i];
        const newEc = { name: ec.name || 'Example', style: ec.style || 'chat', userName: ec.userName || 'Example User', messages: [] as ExampleMessage[] };
        if (ec.messages && Array.isArray(ec.messages)) {
          for (let j = 0; j < ec.messages.length; j++) {
            const m = ec.messages[j];
            newEc.messages.push({ isContact: m.isContact, text: m.text, emotion: m.emotion || 'neutral' });
          }
        }
        newChar.exampleChats.push(newEc);
      }
    }

    charList.push(newChar);
    await saveCharList();
    await updateCharListingUi();

    //api.v1.log('Imported character: ' + newChar.name);
  } catch (e) {
    api.v1.error('Failed to import character:', e);
  }
}

async function exportCharacter(scriptPermission: ScriptPermission, char: Character): Promise<void> {
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  
  const exampleMessages = [];
  for (let i = 0; i < char.exampleChats.length; i++) {
    const ec = char.exampleChats[i];
    const msgs = [];
    for (let j = 0; j < ec.messages.length; j++) {
      const m = ec.messages[j];
      msgs.push({ isContact: m.isContact, text: m.text, emotion: m.emotion });
    }
    exampleMessages.push({ name: ec.name, messages: msgs, userName: ec.userName, style: ec.style });
  }

  // Export avatar as base64 if present
  let avatarBase64 = '';
  if (char.avatar) {
    const avatarData = char.avatar;
    if (avatarData && typeof avatarData === 'string') {
      avatarBase64 = avatarData;
    }
  }

  const exportData = {
    cardType: char.cardType || "contact",
    format: CARD_FORMAT,
    id: char.id,
    author: char.author || DEFAULT_AUTHOR_NAME,
    name: char.name,
    alias: char.alias,
    description: char.description,
    avatarUri: avatarBase64,
    gndr: char.gender,
    pronouns: char.pronouns,
    species: char.species,
    tags: char.tags,
    persona: char.persona,
    appearance: char.appearance,
    greeting: char.greeting,
    greetingEmotion: char.greetingEmotion,
    exampleMessages: exampleMessages,
    emotions: char.emotions,
    relationship: char.defaultIntimacy,
    responseLength: 'unspecified',
    style: char.defaultStyle,
    cjk: char.cjk,
    brains: char.brains || [],
    brainsConditional: char.brainsConditional || [],
    schedule: char.schedule || {}
  };

  await api.v1.file.save(`Character_${char.alias || char.name}_${char.id}.json`, JSON.stringify(exportData, null, 2));
}

// Generate 30-minute intervals.
const TIME_OPTIONS = Array.from({ length: 48 }, (_, i) => i * 30);
const formatTime = (m: number) => {
  const h = Math.floor(m / 60).toString().padStart(2, '0');
  const min = (m % 60).toString().padStart(2, '0');
  return `${h}:${min}`;
};

const scheduleContainerId = "scheduleContainerId";

function scheduleRebuild(char: Character) : UIPart[]
{
  // Init empty schedule if there isn't one, so we don't end up with something undefined.
  if (!char.schedule){
    char.schedule = {
      Daily: [],
      Monday: [],
      Tuesday: [],
      Wednesday: [],
      Thursday: [],
      Friday: [],
      Saturday: [],
      Sunday: []
    }
  }

  let partsList: UIPart[] = [];
  for (const day of DAY_LIST){
    partsList.push(
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "button",
            iconId: "plus",
            callback: async () => {
              await openScheduleEvent(char, null, char.schedule!, day);
            }
          },
          {
            type: "text",
            text: day
          },
        ]
      }
    );
    const eventList = char.schedule[day] || [];
    for (let i = 0; i < eventList.length; i++){
      const previewMax = 35;
      let previewText = eventList[i].text;
      if (previewText.length > previewMax){
        previewText = previewText.slice(0, previewMax) + "...";
      }
      partsList.push(
        {
          type: "container",
          style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
          content: [
            {
              type: "text",
              noTemplate: true,
              text: previewText
            },
            {
              type: "text",
              text: `${formatTime(eventList[i].startTime)} - ${formatTime(eventList[i].endTime)}`
            },
            {
              type: "text",
              text: `Intimacy: ${eventList[i].requiredIntimacy}`
            },
            {
              type: "row",
              spacing: "space-around",
              content: [
                {
                  type: "button",
                  text: "Edit",
                  iconId: "edit",
                  callback: async () => {
                    await openScheduleEvent(char, eventList[i], char.schedule!, day);
                  }
                },
                {
                  type: "button",
                  text: "Delete",
                  iconId: "delete",
                  callback: async () => {
                    char.schedule![day].splice(i, 1);
                    await saveCharList();
                    await reflectCharChangesInChatSettings(char);
                    await api.v1.ui.updateParts([{id: scheduleContainerId, content: [...scheduleRebuild(char)]}]);
                  }
                }
              ]
            },
          ]
        },
      );
    }
  }
  return partsList;
}

async function openSchedule(char: Character)
{
  let scheduleModal = await api.v1.ui.modal.open({
    title: "Schedule",
    content: [
      {
        type: "container",
        id: scheduleContainerId,
        content: [
          ...scheduleRebuild(char)
        ],
      }
    ],
    size: "small"
  });
}

async function openScheduleEvent(
  char: Character,
  existingEvent: ScheduleEvent | null, 
  schedule: Record<Day, ScheduleEvent[]>,
  clickedDay: Day
) {
  let rootElem: any;
  
  // Determine initial state
  const defaultText = existingEvent?.text || "";
  const defaultStart = existingEvent?.startTime || 540; // 09:00
  const defaultEnd = existingEvent?.endTime || 1020;    // 17:00
  const defaultRel = existingEvent?.requiredIntimacy || "none";
  
  // Find which day the existing event belongs to
  let defaultDay: Day = "Monday";
  if (existingEvent) {
    for (const d of DAY_LIST) {
      if (schedule[d]?.some(e => e.id === existingEvent.id)) {
        defaultDay = d;
        break;
      }
    }
  }
  else{
    defaultDay = clickedDay;
  }

  const formState = {
    text: defaultText,
    start: defaultStart,
    end: defaultEnd,
    day: defaultDay,
    rel: defaultRel
  };

  const editModal = await api.v1.ui.modal.open({
    title: existingEvent ? "Edit Event" : "Add Event",
    size: "medium",
    content: [
      api.v1.ui.part.jsx({
        onMount: (elem) => {
          rootElem = elem;
          render(
            <ScheduleEventEditor 
              formState={formState}
            />,
            elem
          );
        }
      })
    ]
  });

  editModal.closed.then( async () => {
    if (rootElem) render(null, rootElem);

    // Remove existing event if editing
    if (existingEvent) {
      for (const d of DAY_LIST) {
        schedule[d] = schedule[d].filter(e => e.id !== existingEvent.id);
      }
    }
    
    // Add/update event
    const id = existingEvent?.id || api.v1.uuid();
    const finalEvt: ScheduleEvent = {
      id,
      startTime: formState.start,
      endTime: formState.end,
      text: formState.text,
      requiredIntimacy: formState.rel as RequiredIntimacy
    };
    
    if (!schedule[formState.day as Day]) schedule[formState.day as Day] = [];
    schedule[formState.day as Day].push(finalEvt);
    schedule[formState.day as Day].sort((a, b) => a.startTime - b.startTime);

    await saveCharList();
    await reflectCharChangesInChatSettings(char);
    await api.v1.ui.updateParts([{id: scheduleContainerId, content: [...scheduleRebuild(char)]}]);
  });
}

function ScheduleEventEditor(props: {
  formState: {
    text: string;
    start: number;
    end: number;
    day: Day;
    rel: string;
  };
}) {
  const [text, setText] = useState(props.formState.text);
  const [start, setStart] = useState(props.formState.start);
  const [end, setEnd] = useState(props.formState.end);
  const [day, setDay] = useState<Day>(props.formState.day);
  const [rel, setRel] = useState(props.formState.rel);

  useEffect(() => {
    props.formState.text = text;
    props.formState.start = start;
    props.formState.end = end;
    props.formState.day = day;
    props.formState.rel = rel;
  }, [text, start, end, day, rel]);

  const containerStyle = { display: 'flex', flexDirection: 'column', gap: '16px', color: 'var(--theme-textMain)' };
  const formGroupStyle = { display: 'flex', flexDirection: 'column', gap: '6px' };
  const labelStyle = { color: 'var(--theme-textHeadings)' as const };
  const inputStyle = { padding: '10px', width: '100%' as const };
  const dropdownStyle = { background: 'var(--theme-bg3)', color: 'var(--theme-textMain)', padding: '10px', width: '100%' as const };
  const rowStyle = { display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '12px' };

  return (
    <div style={containerStyle}>
      <div style={formGroupStyle}>
        <label style={labelStyle}>Description</label>
        <input style={inputStyle} value={text} onInput={e => setText(e.target.value || "")} placeholder="yoga" />
      </div>

      <div style={rowStyle}>
        <div style={formGroupStyle}>
          <label style={labelStyle}>Start Time</label>
          <select style={dropdownStyle} defaultValue={start.toString()} value={start.toString()} onChange={e => setStart(Number(e.target.value))}>
            {TIME_OPTIONS.map(t => <option key={t} value={t.toString()}>{formatTime(t)}</option>)}
          </select>
        </div>
        <div style={formGroupStyle}>
          <label style={labelStyle}>End Time</label>
          <select style={dropdownStyle} defaultValue={end.toString()} value={end.toString()} onChange={e => setEnd(Number(e.target.value))}>
            {TIME_OPTIONS.map(t => <option key={t} value={t.toString()}>{formatTime(t)}</option>)}
          </select>
        </div>
      </div>

      <div style={formGroupStyle}>
        <label style={labelStyle}>Day</label>
        <select style={dropdownStyle} defaultValue={day} value={day} onChange={e => setDay(e.target.value as Day)}>
          {DAY_LIST.map(d => <option key={d} value={d}>{d}</option>)}
        </select>
      </div>

      <div style={formGroupStyle}>
        <label style={labelStyle}>Required Intimacy</label>
        <select style={dropdownStyle} defaultValue={rel} value={rel} onChange={e => setRel(e.target.value)}>
          {["none", "romantic", "close", "acquaintance", "stranger"].map(r => <option key={r} value={r}>{r}</option>)}
        </select>
      </div>
    </div>
  );
}

type VisState = "block" | "none";
function getVisState(showElement: boolean) : VisState
{
  if (showElement){
    return "block";
  }
  else{
    return "none";
  }
}

async function setUiPartVisState(id: string, visible: boolean)
{
  await api.v1.ui.updateParts([
    {
      id: id, 
      style: { display: getVisState(visible) } 
    }
  ]);
}

function getExampleChatModal(chat: ExampleChat, char: Character) : UIPart[]
{
  let partsList: UIPart[] = [];
  function rebuildParts()
  {
    partsList.length = 0;
    for (let i = 0; i < chat.messages.length; i++){
      const visBtnId = `exampleEmotionBtn${i.toString()}`;
      partsList.push(
        {
          type: "container",
          style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
          content: [
            {
              type: "checkboxInput",
              label: "From Character",
              initialValue: chat.messages[i].isContact,
              onChange: async (val) => {
                if (val == true){
                  chat.messages[i].isContact = true;
                }
                else{
                  chat.messages[i].isContact = false;
                }
                await api.v1.ui.updateParts([
                  {
                    id: visBtnId, 
                    style: { display: getVisState(chat.messages[i].isContact), textTransform: "capitalize" }
                  }
                ]);
              }
            },
            {
              type: "multilineTextInput",
              initialValue: chat.messages[i].text,
              onChange: async (val) => {
                chat.messages[i].text = val;
                await saveCharList();
                await reflectCharChangesInChatSettings(char);
              }
            },
            {
              type: "button",
              id: visBtnId,
              style: { display: getVisState(chat.messages[i].isContact), textTransform: "capitalize" },
              text: chat.messages[i].emotion,
              callback: async () => {
                let pickerParts: UIPart[] = [];
                for (const emotion of EMOTION_LIST){
                  pickerParts.push(
                    {
                      type: "button",
                      text: emotion,
                      callback: async () => {
                        chat.messages[i].emotion = emotion;
                        await saveCharList();
                        await reflectCharChangesInChatSettings(char);
                        await api.v1.ui.updateParts([{id: visBtnId, text: emotion}]);
                        pickerModal.close();
                      }
                    }
                  );
                }
                const pickerModal = await api.v1.ui.modal.open({
                  title: "Message Emotion",
                  content: [
                    {
                      type: "container",
                      content: [
                        ...pickerParts
                      ]
                    }
                  ],
                  size: "small"
                });
              }
            },
            {
              type: "row",
              spacing: "end",
              content: [
                {
                  type: "button",
                  text: "Delete",
                  iconId: "delete",
                  callback: async () => {
                    chat.messages.splice(i, 1);
                    await saveCharList();
                    await reflectCharChangesInChatSettings(char);
                    rebuildParts();
                    await api.v1.ui.updateParts([{id: "exampleDisplayContainer", content: [...partsList]}]);
                    //await api.v1.ui.updateParts([{id: "brainsBtnUser", text: `${EDIT_BRAINS_PREFIX}${char.brains.length.toString()}`}]);
                  }
                }
              ]
            }
          ]
        }
      );
    }
  }
  rebuildParts();

  const stylePrefix = "Style: ";
  const styleBtnId = "styleExampleChatBtnId";

  return [
    {
      type: "container",
      style: { display: "flex", flexDirection: "row", flexWrap: "wrap", gap: "2px" },
      content: [
        {
          type: "button",
          text: "Add Message",
          callback: async () => {
            chat.messages.push(
              {
                isContact: true,
                text: "",
                emotion: "neutral"
              }
            );
            await saveCharList();
            await reflectCharChangesInChatSettings(char);
            rebuildParts();
            await api.v1.ui.updateParts([{id: "exampleDisplayContainer", content: [...partsList]}]);
            //await api.v1.ui.updateParts([{id: "brainsBtnUser", text: `${EDIT_BRAINS_PREFIX}${char.brains.length.toString()}`}]);
          }
        },
        {
          type: "button",
          id: styleBtnId,
          text: `${stylePrefix}${chat.style}`,
          callback: async () => {
            let pickerParts: UIPart[] = [];
            for (const style of STYLE_LIST){
              pickerParts.push(
                {
                  type: "button",
                  text: style,
                  callback: async () => {
                    chat.style = style;
                    await saveCharList();
                    await reflectCharChangesInChatSettings(char);
                    await api.v1.ui.updateParts([{id: styleBtnId, text: `${stylePrefix}${chat.style}`}]);
                    pickerModal.close();
                  }
                }
              );
            }
            const pickerModal = await api.v1.ui.modal.open({
              title: "Example Chat Style",
              content: [
                {
                  type: "container",
                  content: [
                    ...pickerParts
                  ]
                }
              ],
              size: "small"
            });
          }
        },
      ]
    },
    {
      type: "column",
      id: "exampleDisplayContainer",
      content: [
        ...partsList
      ]
    }
  ];
}

// Simulate page swap by rebuilding/updating the UI parts to represent a different page.
async function swapDisplayedCharPage(char: Character, page: CardPage, currentPageIndex: number)
{
  await api.v1.ui.updateParts([
    {id: "charPageContainer", content: [...getCharUiPage(char, page), ...getCharUiPageDirChange(char, currentPageIndex)]}
  ]);
}

function getCharUiPageDirChange(char: Character, currentPageIndex: number) : UIPart[]
{
  return [
    {
      type: "row",
      alignment: "center",
      spacing: "center",
      content: [
        {
          type: "button",
          text: "Prev",
          iconId: "chevrons-left",
          callback: async () => {
            currentPageIndex = decrementListWrapAround(currentPageIndex, CHAR_PAGE_LIST.length);
            await swapDisplayedCharPage(char, CHAR_PAGE_LIST[currentPageIndex], currentPageIndex);
          }
        },
        {
          type: "button",
          text: "Next",
          iconId: "chevrons-right",
          callback: async () => {
            currentPageIndex = incrementListWrapAround(currentPageIndex, CHAR_PAGE_LIST.length);
            await swapDisplayedCharPage(char, CHAR_PAGE_LIST[currentPageIndex], currentPageIndex);
          }
        }
      ]
    }
  ];
}

function getCharUiPage(char: Character, page: CardPage) : UIPart[]
{
  if (page === "Metadata")
  {
    return [
      {
        type: "text",
        markdown: true,
        text: `# Metadata\n**Fields that are not seen by the AI**`
      },
      {
        type: "text",
        text: `Avatar (optional)\n>${IMAGE_SIZE_LIMIT.toString()}KB will be prompted for crop/resize to help you save on storage size`
      },
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "image",
            id: "charAvatarId",
            src: char.avatar || "",
            alt: "avatar",
            style: {
              borderRadius: "3em",
              background: "bg3",
              objectFit: "cover"
            },
            width: 64,
            height: 64
          },
          {
            type: "button",
            iconId: "sunset",
            callback: async () => {
              let image = await api.v1.file.prompt({
                accept: "image/*",
                readAs: "dataURL"
              });
              if (image){
                const applyImage = await imageSizeCheckPassed(image);
                if (!applyImage){
                  const resized: string = await getCropAndResizeFromModal(image);
                  if (!resized){
                    return;
                  }
                  image = resized;
                }
                char.avatar = image;
                await saveCharList();
                await reflectCharChangesInChatSettings(char);
                if (chatSettings.char){
                  if (chatSettings.char.id === char.id){
                    clearEditorImages();
                    await updateEditorImages();
                  }
                }
                await api.v1.ui.updateParts([{id: "charAvatarId", src: image}]);
              }
            }
          },
          {
            type: "button",
            iconId: "delete",
            callback: async () => {
              if (char.avatar){
                let modal = await api.v1.ui.modal.open({
                  title: "Delete Avatar?",
                  size: 'small',
                  content: [
                    { type: "text", text: "Are you sure you want to delete the image?" },
                    {
                      type: 'row',
                      style: { marginTop: '16px', gap: '8px', justifyContent: 'flex-end' },
                      content: [
                        { type: 'button', text: 'Cancel', callback: async function() { modal.close(); } },
                        {
                          type: 'button',
                          text: 'Delete',
                          iconId: 'trash',
                          callback: async () => {
                            char.avatar = undefined;
                            await saveCharList();
                            await reflectCharChangesInChatSettings(char);
                            if (chatSettings.char){
                              if (chatSettings.char.id === char.id){
                                clearEditorImages();
                                await updateEditorImages();
                              }
                            }
                            await api.v1.ui.updateParts([{id: "charAvatarId", src: ""}]);
                            modal.close();
                          }
                        }
                      ]
                    }
                  ]
                });
              }
            }
          },
        ]
      },
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "button",
            text: "Set Emotion Images",
            callback: async () => {
              let emoParts: UIPart[] = [];
              for (const emotion of EMOTION_LIST){
                const imgAreaId = `${emotion}AvatarId`;
                emoParts.push(
                  {
                    type: "row",
                    alignment: "center",
                    spacing: "start",
                    style: { marginBotton: "15px" },
                    content: [
                      {
                        type: "image",
                        id: imgAreaId,
                        src: char.emotions[emotion] || "",
                        alt: emotion,
                        style: {
                          borderRadius: "3em",
                          background: "bg3",
                          objectFit: "cover"
                        },
                        width: 64,
                        height: 64
                      },
                      {
                        type: "button",
                        iconId: "sunset",
                        callback: async () => {
                          let image = await api.v1.file.prompt({
                            accept: "image/*",
                            readAs: "dataURL"
                          });
                          if (image){
                            const applyImage = await imageSizeCheckPassed(image);
                            if (!applyImage){
                              const resized: string = await getCropAndResizeFromModal(image);
                              if (!resized){
                                return;
                              }
                              image = resized;
                            }
                            char.emotions[emotion] = image;
                            await saveCharList();
                            await reflectCharChangesInChatSettings(char);
                            if (chatSettings.char){
                              if (chatSettings.char.id === char.id){
                                clearEditorImages();
                                await updateEditorImages();
                              }
                            }
                            await api.v1.ui.updateParts([{id: imgAreaId, src: image}]);
                          }
                        }
                      },
                      {
                        type: "button",
                        iconId: "delete",
                        callback: async () => {
                          if (char.emotions[emotion]){
                            let modal = await api.v1.ui.modal.open({
                              title: "Delete Image?",
                              size: 'small',
                              content: [
                                { type: "text", text: "Are you sure you want to delete the image?" },
                                {
                                  type: 'row',
                                  style: { marginTop: '16px', gap: '8px', justifyContent: 'flex-end' },
                                  content: [
                                    { type: 'button', text: 'Cancel', callback: async function() { modal.close(); } },
                                    {
                                      type: 'button',
                                      text: 'Delete',
                                      iconId: 'trash',
                                      callback: async () => {
                                        delete char.emotions[emotion];
                                        await saveCharList();
                                        await reflectCharChangesInChatSettings(char);
                                        if (chatSettings.char){
                                          if (chatSettings.char.id === char.id){
                                            clearEditorImages();
                                            await updateEditorImages();
                                          }
                                        }
                                        await api.v1.ui.updateParts([{id: imgAreaId, src: ""}]);
                                        modal.close();
                                      }
                                    }
                                  ]
                                }
                              ]
                            });
                          }
                        }
                      },
                      {
                        type: "text",
                        text: emotion
                      },
                    ]
                  }
                );
              }
              const emoModal = await api.v1.ui.modal.open({
                title: "Set Emotion Images",
                content: [
                  {
                    type: "row",
                    alignment: "center",
                    spacing: "start",
                    content: [
                      {
                        type: "text",
                        text: "Note: All must be set for any to show up in your chat."
                      }
                    ]
                  },
                  ...emoParts
                ],
                size: "medium"
              });
            }
          },
        ]
      },
      {
        type: "textInput",
        label: "Author",
        initialValue: char.author,
        onChange: async (val) => {
          char.author = val;
          await saveCharList();
          await reflectCharChangesInChatSettings(char);
        }
      },
      {
        type: "textInput",
        label: "Description",
        initialValue: char.description,
        onChange: async (val) => {
          char.description = val;
          await saveCharList();
          await reflectCharChangesInChatSettings(char);
        }
      },
      {
        type: "textInput",
        label: "Alias Name (optional)",
        initialValue: char.alias,
        onChange: async (val) => {
          char.alias = val;
          await saveCharList();
          await reflectCharChangesInChatSettings(char);
          if (chatSettings.char){
            if (char.id === chatSettings.char!.id){
              await api.v1.ui.updateParts([
                {id: "charSelectChatSettingBtn", text: `${charPrefix}${char.alias || char.name}`},
              ]);
            }
          }
        }
      },
      ...getMacroSamplerUi(),
    ];
  }
  else if (page === "Attributes")
  {
    return [
      {
        type: "text",
        markdown: true,
        text: "# Attributes\n**Define the character**"
      },
      {
        type: "textInput",
        label: "Name",
        initialValue: char.name,
        onChange: async (val) => {
          char.name = val;
          await saveCharList();
          await reflectCharChangesInChatSettings(char);
        }
      },
      {
        type: "row",
        content: [
          {
            type: "textInput",
            label: "Species",
            initialValue: char.species,
            onChange: async (val) => {
              char.species = val;
              await saveCharList();
              await reflectCharChangesInChatSettings(char);
            }
          },
          {
            type: "textInput",
            label: "Gender",
            initialValue: char.gender,
            onChange: async (val) => {
              char.gender = val;
              await saveCharList();
              await reflectCharChangesInChatSettings(char);
            }
          },
          {
            type: "textInput",
            label: "Pronouns",
            initialValue: char.pronouns,
            onChange: async (val) => {
              char.pronouns = val;
              await saveCharList();
              await reflectCharChangesInChatSettings(char);
            }
          },
        ]
      },
      {
        type: "multilineTextInput",
        label: "Personality",
        initialValue: char.persona,
        onChange: async (val) => {
          char.persona = val;
          await saveCharList();
          await reflectCharChangesInChatSettings(char);
        }
      },
      {
        type: "multilineTextInput",
        label: "Appearance",
        initialValue: char.appearance,
        onChange: async (val) => {
          char.appearance = val;
