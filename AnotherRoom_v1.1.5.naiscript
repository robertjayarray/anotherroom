await api.v1.storyStorage.setIfAbsent(EMOTIONAL_MEMORY_RECORD_KEY, emotionalMemoryRecord);
emotionalMemoryRecord = await api.v1.storyStorage.get(EMOTIONAL_MEMORY_RECORD_KEY);

let continuityCreationRecord: Record<string, BrainEntry[]> = {};
