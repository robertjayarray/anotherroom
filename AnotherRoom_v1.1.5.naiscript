      },
      {
        type: "button",
        text: "Add Brain",
        callback: async () => {
          char.brains.push({name: "New Brain", content: ""});
          await saveCharList();
          await reflectCharChangesInChatSettings(char);
          rebuildBrainParts();
          await api.v1.ui.updateParts([{id: brainDisplayContainerId, content: [...brainPartsList]}]);
        }
      },
      {
        type: "button",
        text: "Add Conditional Brain",
        callback: async () => {
          char.brainsConditional.push({name: "New Brain", content: "", keys: [], requiredIntimacy: "none"});
          await saveCharList();
          await reflectCharChangesInChatSettings(char);
          rebuildBrainParts();
          await api.v1.ui.updateParts([{id: brainDisplayContainerId, content: [...brainPartsList]}]);
        }
      },
      {
        type: "column",
        id: brainDisplayContainerId,
        content: [
          ...brainPartsList
        ]
      }
    ];
  }
  else if (page === "Messages"){
    let chatPartsList: UIPart[] = [];
    function rebuildChatParts()
    {
      chatPartsList.length = 0;
      for (let i = 0; i < char.exampleChats.length; i++){
        chatPartsList.push(
          {
            type: "container",
            style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
            content: [
              {
                type: "textInput",
                label: "Chat Name",
                initialValue: char.exampleChats[i].name,
                onChange: async (val) => {
                  char.exampleChats[i].name = val;
                  await saveCharList();
                  await reflectCharChangesInChatSettings(char);
                }
              },
              {
                type: "textInput",
                label: "User Name",
                initialValue: char.exampleChats[i].userName,
                onChange: async (val) => {
                  char.exampleChats[i].userName = val;
                  await saveCharList();
                  await reflectCharChangesInChatSettings(char);
                }
              },
              {
                type: "text",
                text: `Messages: ${char.exampleChats[i].messages.length.toString()}\nStyle: ${char.exampleChats[i].style}`
              },
              {
                type: "row",
                spacing: "space-around",
                content: [
                  {
                    type: "button",
                    text: "Edit",
                    iconId: "edit",
                    callback: async () => {
                      const modal = await api.v1.ui.modal.open({
                        title: "Example Chat",
                        content: [
                          ...getExampleChatModal(char.exampleChats[i], char)
                        ],
                        size: "medium",
                      });
                      modal.closed.then( async () => {
                        rebuildChatParts();
                        await api.v1.ui.updateParts([{id: "chatDisplayContainer", content: [...chatPartsList]}]);
                      });
                    }
                  },
                  {
                    type: "button",
                    text: "Delete",
                    iconId: "delete",
                    callback: async () => {
                      char.exampleChats.splice(i, 1);
                      await saveCharList();
                      await reflectCharChangesInChatSettings(char);
                      rebuildChatParts();
                      await api.v1.ui.updateParts([{id: "chatDisplayContainer", content: [...chatPartsList]}]);
                      //await api.v1.ui.updateParts([{id: "brainsBtnUser", text: `${EDIT_BRAINS_PREFIX}${char.brains.length.toString()}`}]);
                    }
                  }
                ]
              }
            ]
          }
        );
      }
    }
    rebuildChatParts();

    return [
      {
        type: "text",
        markdown: true,
        text: "# Example Chats\n**Sample exchanges between character and a user**"
      },
      {
        type: "button",
        text: "Add Example Chat",
        callback: async () => {
          char.exampleChats.push(
            {
              name: "New Example Chat",
              style: "chat",
              userName: "Example User",
              messages: []
            }
          );
          await saveCharList();
          await reflectCharChangesInChatSettings(char);
          const modal = await api.v1.ui.modal.open({
            title: "Example Chat",
            content: [
              ...getExampleChatModal(char.exampleChats[char.exampleChats.length - 1], char)
            ],
            size: "medium",
          });
          modal.closed.then( async () => {
            rebuildChatParts();
            await api.v1.ui.updateParts([{id: "chatDisplayContainer", content: [...chatPartsList]}]);
          });
          //await api.v1.ui.updateParts([{id: "chatDisplayContainer", content: [...chatPartsList]}]);
          //await api.v1.ui.updateParts([{id: "brainsBtnUser", text: `${EDIT_BRAINS_PREFIX}${char.brains.length.toString()}`}]);
        }
      },
      {
        type: "column",
        id: "chatDisplayContainer",
        content: [
          ...chatPartsList
        ]
      }
    ];
  }
  else{
    return [];
  }
}

function getCharUiModal(char: Character) : UIPart[]
{
  let currentPageIndex: number = 0;
  return [
    {
      type: "container",
      style: { overflow: "scroll", maxHeight: "90%" },
      content: [
        {
          type: "row",
          style: { display: "flex", flexWrap: "wrap", gap: "20px" },
          content: [
            {
              type: "column",
              id: "charPageContainer",
              spacing: "start",
              style: { flex: "25em", maxWidth: "35em" },
              content: [
                ...getCharUiPage(char, CHAR_PAGE_LIST[currentPageIndex]),
                ...getCharUiPageDirChange(char, currentPageIndex)
              ]
            },
          ]
        },
      ]
    },
    {
      type: "row",
      spacing: "center",
      content: [
        {
          type: "button",
          iconId: "info",
          callback: async () => {
            const swapTo: CardPage = "Metadata";
            currentPageIndex = CHAR_PAGE_LIST.indexOf(swapTo);
            await swapDisplayedCharPage(char, swapTo, currentPageIndex);
          }
        },
        {
          type: "button",
          iconId: "list",
          callback: async () => {
            const swapTo: CardPage = "Attributes";
            currentPageIndex = CHAR_PAGE_LIST.indexOf(swapTo);
            await swapDisplayedCharPage(char, swapTo, currentPageIndex);
          }
        },
        {
          type: "button",
          iconId: "users",
          callback: async () => {
            const swapTo: CardPage = "Opening";
            currentPageIndex = CHAR_PAGE_LIST.indexOf(swapTo);
            await swapDisplayedCharPage(char, swapTo, currentPageIndex);
          }
        },
        {
          type: "button",
          iconId: "book",
          callback: async () => {
            const swapTo: CardPage = "Brains";
            currentPageIndex = CHAR_PAGE_LIST.indexOf(swapTo);
            await swapDisplayedCharPage(char, swapTo, currentPageIndex);
          }
        },
        {
          type: "button",
          iconId: "message-square",
          callback: async () => {
            const swapTo: CardPage = "Messages";
            currentPageIndex = CHAR_PAGE_LIST.indexOf(swapTo);
            await swapDisplayedCharPage(char, swapTo, currentPageIndex);
          }
        },
      ]
    }
  ];
}

function prepareMarkdown(text: string): string {
  var lines = text.split('\n');
  var result: string[] = [];
  var inCodeBlock = false;
  for (var i = 0; i < lines.length; i++) {
    var line = lines[i];
    if (line.trimStart().startsWith('```')) {
      inCodeBlock = !inCodeBlock;
      result.push(line);
    } else if (inCodeBlock) {
      result.push(line);
    } else {
      // Add two trailing spaces for markdown hard line break
      result.push(line + '  ');
    }
  }
  if (inCodeBlock) {
    result.push('```');
  }
  return result.join('\n');
}

function applyBoldSpeechLine(line: string): string {
  var result = '';
  var pos = 0;
  while (pos < line.length) {
    if (line[pos] === '*') {
      var end = line.indexOf('*', pos + 1);
      if (end === -1) {
        // Unpaired * — treat rest as-is
        var rest = line.slice(pos);
        result += rest;
        pos = line.length;
      } else {
        result += line.slice(pos, end + 1);
        pos = end + 1;
      }
    } else {
      var next = line.indexOf('*', pos);
      var segment = next === -1 ? line.slice(pos) : line.slice(pos, next);
      if (segment.trim()) {
        var leadMatch = segment.match(/^(\s*)/);
        var trailMatch = segment.match(/(\s*)$/);
        var lead = leadMatch ? leadMatch[1] : '';
        var trail = trailMatch ? trailMatch[1] : '';
        var trimmed = segment.trim();
        result += lead + '**' + trimmed + '**' + trail;
      } else {
        result += segment;
      }
      pos = next === -1 ? line.length : next;
    }
  }
  return result;
}

function applyBoldSpeech(text: string): string {
  var lines = text.split('\n');
  var result: string[] = [];
  var inCodeBlock = false;
  for (var i = 0; i < lines.length; i++) {
    if (lines[i].trimStart().startsWith('```')) {
      inCodeBlock = !inCodeBlock;
      result.push(lines[i]);
    } else if (inCodeBlock) {
      result.push(lines[i]);
    } else {
      result.push(applyBoldSpeechLine(lines[i]));
    }
  }
  return result.join('\n');
}

function buildMessageBubbleForPost(
  name: string,
  text: string,
  emotion: Emotion,
  imgUri?: string
): UIPart {
  // Header row with name on left, controls on right
  const headerRightContent: UIPart[] = [];

  // Emotion label (only for contact messages)
  headerRightContent.push({
    type: 'text',
    text: emotion,
    style: { fontSize: '0.6875rem', opacity: 0.6, fontStyle: 'italic', margin: 0, marginRight: '8px', textTransform: 'capitalize' }
  });

  const messageContent: UIPart[] = [
    // Header with name and controls
    {
      type: 'row',
      spacing: 'space-between',
      alignment: 'center',
      style: { marginBottom: '4px' },
      content: [
        { type: 'text', text: name, style: { fontWeight: 'bold', fontSize: '0.8125rem', margin: 0 } },
        { type: 'row', alignment: 'center', content: headerRightContent }
      ]
    },
    // Message text
    {
      type: 'text',
      text: prepareMarkdown(text),
      markdown: true,
      style: { fontSize: "14px", margin: 0 }
    }
  ];

  // For no avatar, we'll try same fit but blank image.
  return {
    type: 'row',
    style: {
      marginBottom: '12px',
      borderRadius: '4px',
      gap: 0,
      alignItems: 'flex-start',
      alignSelf: 'flex-start',
      width: '90%',
      backgroundColor: 'bg2'
    },
    content: [
      {
        type: 'image',
        src: imgUri || PLACEHOLDER_FORUM_AVATAR,
        width: 64,
        height: 64,
        style: {
          width: "3em",
          height: "3em",
          borderRadius: "3em",
          objectFit: "cover",
          background: "bg3",
          position: "relative",
          top: '-1px',
          left: '-1px'
        },
      },
      {
        type: 'column',
        spacing: 'start',
        style: {
          marginBottom: '12px',
          borderRadius: '4px',
          marginLeft: '0',
          alignSelf: 'flex-start',
          width: '90%',
          backgroundColor: 'bg1',
          gap: '4px',
          padding: '8px 12px'
        },
        content: messageContent
      }
    ]
  };

  /*
  // For contact messages without images (matching custombot for no-image case)
  return {
    type: 'column',
    style: {
      marginBottom: '12px',
      borderRadius: '4px',
      marginLeft: '0',
      alignSelf: 'flex-start',
      width: '90%',
      backgroundColor: 'bg1',
      gap: '4px',
      padding: '8px 12px'
    },
    content: messageContent
  };
  */
}

function buildMessageBubble(
  name: string,
  text: string,
  emotion: Emotion,
  sender: string,
  char: Character,
  siblingIndex: number,
  siblingCount: number,
  onPrev?: () => Promise<void>,
  onNext?: () => Promise<void>,
  onReroll?: () => Promise<void>,
  onEdit?: () => Promise<void>,
  onDelete?: () => Promise<void>,
  hasBrain?: boolean,
  onBrain?: () => Promise<void>
): UIPart {
  const isContact = sender === 'contact';
  const emotionImage = isContact ? (char.emotions[emotion] || char.avatar) : undefined;

  // Header row with name on left, controls on right
  const headerRightContent: UIPart[] = [];

  // Emotion label (only for contact messages)
  if (isContact) {
    headerRightContent.push({
      type: 'text',
      text: emotion,
      style: { fontSize: '0.6875rem', opacity: 0.6, fontStyle: 'italic', margin: 0, marginRight: '8px', textTransform: 'capitalize' }
    });
  }

  // Branch navigation: < X/Y > (shows position among siblings)
  if (siblingCount > 0) {
    // < button
    headerRightContent.push({
      type: 'button',
      iconId: 'chevron-left',
      style: { margin: 0, padding: '2px 4px', opacity: siblingCount <= 1 ? 0.3 : 1 },
      disabled: siblingCount <= 1,
      callback: onPrev || (async function() {})
    });

    // X / Y text
    headerRightContent.push({
      type: 'text',
      text: (siblingIndex + 1) + ' / ' + siblingCount,
      style: { fontSize: '0.6875rem', opacity: 0.7, margin: '0 2px', whiteSpace: 'nowrap' }
    });

    // > button
    headerRightContent.push({
      type: 'button',
      iconId: 'chevron-right',
      style: { margin: 0, padding: '2px 4px', opacity: siblingCount <= 1 ? 0.3 : 1 },
      disabled: siblingCount <= 1,
      callback: onNext || (async function() {})
    });
  }

  // Reroll button
  if (onReroll) {
    headerRightContent.push({
      type: 'button',
      iconId: 'rotate-ccw',
      style: { margin: 0, padding: '2px 6px', marginLeft: '4px' },
      disabledWhileCallbackRunning: true,
      callback: onReroll
    });
  }

  // Edit button
  if (onEdit) {
    headerRightContent.push({
      type: 'button',
      iconId: 'edit',
      style: { margin: 0, padding: '2px 6px', marginLeft: '4px' },
      callback: onEdit
    });
  }

  // Brain button
  if (onBrain) {
    headerRightContent.push({
      type: 'button',
      text: hasBrain ? '\uD83E\uDDE0' : '\uD83D\uDCAD',
      style: { margin: 0, padding: '2px 6px', marginLeft: '4px' },
      callback: onBrain
    });
  }

  // Delete button
  if (onDelete) {
    headerRightContent.push({
      type: 'button',
      iconId: 'x',
      style: { margin: 0, padding: '2px 6px', marginLeft: '4px' },
      callback: onDelete
    });
  }

  const messageContent: UIPart[] = [
    // Header with name and controls
    {
      type: 'row',
      spacing: 'space-between',
      alignment: 'center',
      style: { marginBottom: '4px' },
      content: [
        { type: 'text', text: name, style: { fontWeight: 'bold', fontSize: '0.8125rem', margin: 0 } },
        { type: 'row', alignment: 'center', content: headerRightContent }
      ]
    },
    // Message text
    {
      type: 'text',
      text: prepareMarkdown(text),
      markdown: true,
      style: { fontSize: "14px", margin: 0 }
    }
  ];

  // For contact messages with images, show image on the left (matching custombot exactly)
  if (isContact && Object.keys(char.emotions).length === 24) {
    return {
      type: 'row',
      style: {
        marginBottom: '12px',
        borderRadius: '4px',
        gap: 0,
        alignItems: 'flex-start',
        alignSelf: 'flex-start',
        width: '90%',
        backgroundColor: 'bg2'
      },
      content: [
        {
          type: 'image',
          src: char.emotions[emotion],
          width: 64,
          height: 64,
          style: {
            width: "3em",
            height: "3em",
            borderRadius: "3em",
            objectFit: "cover",
            background: "bg3",
            position: "relative",
            top: '-1px',
            left: '-1px'
          },
        },
        {
          type: 'column',
          spacing: 'start',
          style: {
            marginBottom: '12px',
            borderRadius: '4px',
            marginLeft: '0',
            alignSelf: 'flex-start',
            width: '90%',
            backgroundColor: 'bg1',
            gap: '4px',
            padding: '8px 12px'
          },
          content: messageContent
        }
      ]
    };
  }
  
  if (isContact && char.avatar) {
    return {
      type: 'row',
      style: {
        marginBottom: '12px',
        borderRadius: '4px',
        gap: 0,
        alignItems: 'flex-start',
        alignSelf: 'flex-start',
        width: '90%',
        backgroundColor: 'bg2'
      },
      content: [
        {
          type: 'image',
          src: char.avatar,
          width: 64,
          height: 64,
          style: {
            width: "3em",
            height: "3em",
            borderRadius: "3em",
            objectFit: "cover",
            background: "bg3",
            position: "relative",
            top: '-1px',
            left: '-1px'
          },
        },
        {
          type: 'column',
          spacing: 'start',
          style: {
            marginBottom: '12px',
            borderRadius: '4px',
            marginLeft: '0',
            alignSelf: 'flex-start',
            width: '90%',
            backgroundColor: 'bg1',
            gap: '4px',
            padding: '8px 12px'
          },
          content: messageContent
        }
      ]
    };
  }

  // For contact messages without images (matching custombot for no-image case)
  if (isContact) {
    return {
      type: 'column',
      style: {
        marginBottom: '12px',
        borderRadius: '4px',
        marginLeft: '0',
        alignSelf: 'flex-start',
        width: '90%',
        backgroundColor: 'bg1',
        gap: '4px',
        padding: '8px 12px'
      },
      content: messageContent
    };
  }

  // For user messages, align to the right and grow from right
  return {
    type: 'column',
    style: {
      marginBottom: '12px',
      borderRadius: '4px',
      alignSelf: 'flex-end',
      maxWidth: '85%',
      backgroundColor: 'bg1',
      gap: '4px',
      padding: '8px 12px'
    },
    content: messageContent
  };
}

function parseResponseBody(text: string, charName: string): SubMessage[] {
  const subMessages: SubMessage[] = [];
  const lines = text.split('\n');
  
  let currentText = '';
  let currentEmotion = 'neutral';
  let inMessage = false;
  
  const escapedName = escapeRegex(charName);
  const nameRegex = new RegExp('^' + escapedName + ':\\s*(.*)$', 'i');
  
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const emotionMatch = line.match(/^\s{2}Emotion:\s*(\w+)/i);
    const nameMatch = line.match(nameRegex);
    const continuationMatch = line.match(/^\s{4}(.*)$/);
    
    if (emotionMatch) {
      const emotionStr = emotionMatch[1].toLowerCase();
      if (EMOTION_LIST.indexOf(emotionStr) >= 0) {
        currentEmotion = emotionStr;
      }
      if (currentText.trim()) {
        subMessages.push({ text: currentText.trim(), emotion: currentEmotion });
        currentText = '';
        currentEmotion = 'neutral';
      }
      inMessage = false;
    } else if (nameMatch) {
      if (currentText.trim() && inMessage) {
        subMessages.push({ text: currentText.trim(), emotion: 'neutral' });
      }
      currentText = nameMatch[1];
      inMessage = true;
    } else if (continuationMatch && inMessage) {
      currentText += '\n' + continuationMatch[1];
    } else if (inMessage && line.trim() && !line.startsWith('  ')) {
      currentText += ' ' + line.trim();
    }
  }
  
  if (currentText.trim()) {
    subMessages.push({ text: currentText.trim(), emotion: currentEmotion });
  }
  
  if (subMessages.length === 0 && text.trim()) {
    let cleanText = text.trim();
    const leadingNameMatch = cleanText.match(new RegExp('^' + escapedName + ':\\s*', 'i'));
    if (leadingNameMatch) {
      cleanText = cleanText.slice(leadingNameMatch[0].length);
    }
    subMessages.push({ text: cleanText || text.trim(), emotion: 'neutral' });
  }
  
  return subMessages;
}

function buildDeletionSystemPrompt(char: Character, user: User): string {
  let prompt = 'AetherRoom\n----\n';
  prompt += char.name + '\n';
  prompt += 'Type: contact\n';
  if (char.gender && char.gender.trim()) prompt += formatField('Gender', char.gender);
  if (char.pronouns && char.pronouns.trim()) prompt += formatField('Pronouns', char.pronouns);
  if (char.species && char.species.trim()) prompt += formatField('Species', char.species);
  if (char.persona && char.persona.trim()) prompt += formatField('Personality', char.persona);
  if (char.appearance && char.appearance.trim()) prompt += formatField('Appearance', char.appearance);
  const intimacy = char.defaultIntimacy || 'stranger';
  if (intimacy === 'stranger') {
    prompt += 'Opinion of ' + user.name + ': Doesn\'t know ' + user.name + '.\n';
  } else {
    prompt += 'Relationship: ' + intimacy + '\n';
  }
  if (char.tags && char.tags.trim()) prompt += 'Categories: ' + char.tags.trim() + '\n';

  if (char.exampleChats.length > 0) {
    prompt += 'Example quotes:\n';
    for (let ecIdx = 0; ecIdx < char.exampleChats.length; ecIdx++) {
      const ec = char.exampleChats[ecIdx];
      prompt += (ecIdx + 1) + '.\n';
      for (let msgIdx = 0; msgIdx < ec.messages.length; msgIdx++) {
        const msg = ec.messages[msgIdx];
        const senderName = msg.isContact ? char.name : ec.userName;
        const lines = msg.text.split('\n');
        prompt += '\u2002' + senderName + ': ' + lines[0] + '\n';
        for (let li = 1; li < lines.length; li++) {
          prompt += '\u2002    ' + lines[li] + '\n';
        }
        if (msg.isContact && msg.emotion) {
          prompt += '\u2002  Emotion: ' + msg.emotion + '\n';
        }
      }
    }
  }

  prompt += '----\n';
  prompt += user.name + '\n';
  prompt += 'Type: user\n';
  if (user.gender && user.gender.trim()) prompt += formatField('Gender', user.gender);
  if (user.pronouns && user.pronouns.trim()) prompt += formatField('Pronouns', user.pronouns);
  if (user.species && user.species.trim()) prompt += formatField('Species', user.species);
  if (user.persona && user.persona.trim()) prompt += formatField('Personality', user.persona);
  if (user.appearance && user.appearance.trim()) prompt += formatField('Appearance', user.appearance);
  if (user.tags && user.tags.trim()) prompt += 'Categories: ' + user.tags.trim() + '\n';

  // Global brains from character and user (no scenario for deletion)
  const allBrains: BrainEntry[] = [];
  if (char.brains) {
    for (let bi = 0; bi < char.brains.length; bi++) allBrains.push(char.brains[bi]);
  }
  if (user.brains) {
    for (let bi = 0; bi < user.brains.length; bi++) allBrains.push(user.brains[bi]);
  }
  for (let bi = 0; bi < allBrains.length; bi++) {
    prompt += '----\n' + allBrains[bi].name + '\n' + allBrains[bi].content.trim() + '\n';
  }

  return replaceMacros(prompt, char.name, user.name);
}

async function confirmDeleteCharacter(char: Character, itemIndex: number): Promise<void>
{
  const user = chatSettings.user || createUserTemplate();

  let deleteEnabled = false;
  let generatedBubble: UIPart | null = null;

  function buildModalContent(): UIPart[] {
    const content: UIPart[] = [
      { type: 'text', text: 'Are you sure you want to delete "' + char.name + '"?' }
    ];
    if (generatedBubble) {
      content.push({ type: 'container', style: { marginTop: '12px', marginBottom: '4px' }, content: [generatedBubble] });
    } else {
      content.push({ type: 'text', text: `${char.name} is typing...`, style: { marginTop: '12px', opacity: 0.5, fontStyle: 'italic' } });
    }
    content.push({
      type: 'row',
      style: { marginTop: '16px', gap: '8px', justifyContent: 'flex-end' },
      content: [
        { type: 'button', text: 'Cancel', callback: async function() { modal.close(); return false; } },
        {
          type: 'button',
          text: 'Delete',
          iconId: 'trash',
          disabled: !deleteEnabled,
          callback: (function(c) { return async function() {
            if (!deleteEnabled) return;
            /*
            if (c.avatar) await api.v1.storyStorage.remove(c.avatar);
            const emotionKeys = Object.values(c.emotions);
            for (let i = 0; i < emotionKeys.length; i++) {
              await api.v1.storyStorage.remove(emotionKeys[i]);
            }
            */
            if (charList[itemIndex].id === chatSettings.char?.id){
              chatSettings.char = undefined;
              chatSettings.intimacy = FALLBACK_INTIMACY;
              chatSettings.style = FALLBACK_STYLE;
              await saveChatSettings();
              await updateChatSettingsUi();
            }
            charList.splice(itemIndex, 1);
            await saveCharList();
            await updateCharListingUi();
            modal.close();
          }; })(char)
        }
      ]
    });
    return content;
  }

  let modal: any;
  modal = await api.v1.ui.modal.open({
    title: 'Delete Character?',
    size: 'medium',
    content: buildModalContent()
  });

  // Enable delete after 2s timeout regardless of generation
  api.v1.timers.setTimeout(function() {
    if (modal.isClosed()) return;
    deleteEnabled = true;
    modal.update({ content: buildModalContent() });
  }, 2000);

  // Generate deletion response in background
  if (user) {
    try {
      const genParams = await api.v1.generationParameters.get();
      if (genParams.model === 'glm-4-6') genParams.model = 'xialong-v1';
      const systemPrompt = buildDeletionSystemPrompt(char, user);
      let styleMsg = '[ Style: deletion response ]';
      if (char.cjk) {
        styleMsg = '[ Style: deletion response; CJK ]';
      }
      const messages: APIMessage[] = [
        { role: 'system', content: systemPrompt },
        { role: 'system', content: 'Start of chat.' },
        { role: 'system', content: styleMsg }
      ];

      const response = await api.v1.generate(
        messages,
        {
          model: genParams.model,
          max_tokens: 1536,
          temperature: genParams.temperature,
          top_p: genParams.top_p,
          top_k: genParams.top_k,
          min_p: genParams.min_p,
        },
        async function() {},
        'background'
      );

      if (modal.isClosed()) return;
      const responseText = response.choices[0]?.text || '';
      const subMessages = parseResponseBody(responseText, char.name);
      if (subMessages.length > 0) {
        const sub = subMessages[0];
        generatedBubble = buildMessageBubble(
          char.name, sub.text, sub.emotion, 'contact', char,
          0, 0
        );
      }
    } catch (e) {
      // Generation failed, just enable delete
    }
    if (modal.isClosed()) return;
    deleteEnabled = true;
    modal.update({ content: buildModalContent() });
  }
}

