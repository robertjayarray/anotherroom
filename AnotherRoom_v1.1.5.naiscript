            await swapDisplayedScenarioPage(scenario, swapTo, currentPageIndex);
          }
        },
      ]
    }
  ];
}

const USER_LIST_KEY = "userListKey";
// This is not C++. We use function to make sure it's a new object rather than a reference to const template.
// Who would do a thing like that? Not me, that's who. Surely never.
function createUserTemplate(): User {
  return {
    cardType: "user",
    format: CARD_FORMAT,
    id: api.v1.uuid(),
    author: defaultAuthorUsersetting || DEFAULT_AUTHOR_NAME,
    name: "Anon",
    brains: [],
    brainsConditional: []
  };
}
let userList: User[] = [];
await api.v1.storage.setIfAbsent(USER_LIST_KEY, userList);
userList = await api.v1.storage.get(USER_LIST_KEY);

async function saveUserList()
{
  await api.v1.storage.set(USER_LIST_KEY, userList);
}

async function reflectUserChangesInChatSettings(user: User) : Promise<void>
{
  // We do this to avoid annoying situations where user changes something about a char/user/scenario
  // that is currently set, but the user has to reselect it for the changes to reflect in chatSettings.
  if (!chatSettings.user){
    return;
  }
  if (user.id === chatSettings.user.id){
    chatSettings.user = user;
    await saveChatSettings();
  }
}

async function exportUser(scriptPermission: ScriptPermission, user: User): Promise<void> {
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  
  if (user.author === ""){
    user.author = DEFAULT_AUTHOR_NAME;
  }
  user.cardType = "user";
  await api.v1.file.save(`User_${user.name}_${user.id}.json`, JSON.stringify(user, null, 2));
}

async function importUser(scriptPermission: ScriptPermission): Promise<void> {
  const hasPermission = await permissionCheckPassed(scriptPermission);
  if (!hasPermission){
    permissionRejectedShowWarning(scriptPermission);
    return;
  }
  
  const file = await api.v1.file.prompt({ accept: '.json' });
  if (!file) return;
  
  try {
    const data = JSON.parse(file);
    if (data.cardType){
      if (data.cardType != "user"){
        api.v1.ui.toast("Card type is not user. Canceling import.", {type: "warning"});
        return;
      }
    }
    const newUser = createUserTemplate();
    newUser.id = data.id || api.v1.uuid();
    const existingId = userList.findIndex(obj => obj.id === newUser.id);
    if (existingId != -1){
      api.v1.ui.toast("A User with the same id already exists. Canceling import.", {type: "warning"});
      return;
    }
    newUser.author = data.author || DEFAULT_AUTHOR_NAME;
    newUser.name = data.name || newUser.name;
    newUser.description = data.description;
    newUser.species = data.species;
    newUser.gender = data.gender;
    newUser.pronouns = data.pronouns;
    newUser.persona = data.persona;
    newUser.appearance = data.appearance;
    newUser.tags = data.tags;
    if (data.brains && Array.isArray(data.brains)) newUser.brains = data.brains;
    if (data.brainsConditional && Array.isArray(data.brainsConditional)){
      newUser.brainsConditional = data.brainsConditional;
    }
    userList.push(newUser);
    await saveUserList();
    await updateUserListingUi();
  } catch (e) {
    api.v1.error('Failed to import user:', e);
  }
}

async function swapDisplayedUserPage(user: User, page: CardPage, currentPageIndex: number)
{
  await api.v1.ui.updateParts([
    {id: "userPageContainer", content: [...getUserUiPage(user, page), ...getUserUiPageDirChange(user, currentPageIndex)]}
  ]);
}

function getUserUiPageDirChange(user: User, currentPageIndex: number) : UIPart[]
{
  return [
    {
      type: "row",
      alignment: "center",
      spacing: "center",
      content: [
        {
          type: "button",
          text: "Prev",
          iconId: "chevrons-left",
          callback: async () => {
            currentPageIndex = decrementListWrapAround(currentPageIndex, USER_PAGE_LIST.length);
            await swapDisplayedUserPage(user, USER_PAGE_LIST[currentPageIndex], currentPageIndex);
          }
        },
        {
          type: "button",
          text: "Next",
          iconId: "chevrons-right",
          callback: async () => {
            currentPageIndex = incrementListWrapAround(currentPageIndex, USER_PAGE_LIST.length);
            await swapDisplayedUserPage(user, USER_PAGE_LIST[currentPageIndex], currentPageIndex);
          }
        }
      ]
    }
  ];
}

function getUserUiPage(user: User, page: CardPage) : UIPart[]
{
  if (page === "Metadata")
  {
    return [
