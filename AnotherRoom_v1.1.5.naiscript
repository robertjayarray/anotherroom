async function confirmDeleteScenario(scenario: Scenario, itemIndex: number): Promise<void> {
  let modal: any;
  modal = await api.v1.ui.modal.open({
    title: 'Delete Scenario?',
    size: 'small',
    content: [
      { type: 'text', text: 'Are you sure you want to delete "' + scenario.name + '"?' },
      {
        type: 'row',
        style: { marginTop: '16px', gap: '8px', justifyContent: 'flex-end' },
        content: [
          { type: 'button', text: 'Cancel', callback: async function() { modal.close(); } },
          {
            type: 'button',
            text: 'Delete',
            iconId: 'trash',
            callback: async () => {
              if (scenarioList[itemIndex].id === chatSettings.scenario?.id){
                chatSettings.scenario = undefined;
                await saveChatSettings();
                await updateChatSettingsUi();
              }
              scenarioList.splice(itemIndex, 1);
              await saveScenarioList();
              await updateScenarioListingUi();
              modal.close();
            }
          }
        ]
      }
    ]
  });
}

