        onChange: async (val) => {
          char.greeting = val;
          await saveCharList();
          await reflectCharChangesInChatSettings(char);
        }
      },
      {
        type: "text",
        text: "Greeting Emotion",
        style: { marginBottom: "4px" }
      },
      {
        type: "button",
        id: "greetingEmotionBtn",
        style: { textTransform: "capitalize" },
        text: char.greetingEmotion || FALLBACK_EMOTION,
        callback: async () => {
          let pickerParts: UIPart[] = [];
          for (const emotion of EMOTION_LIST){
            pickerParts.push(
              {
                type: "button",
                text: emotion,
                callback: async () => {
                  char.greetingEmotion = emotion;
                  await saveCharList();
                  await reflectCharChangesInChatSettings(char);
                  await api.v1.ui.updateParts([{id: "greetingEmotionBtn", text: emotion}]);
                  pickerModal.close();
                }
              }
            );
          }
          const pickerModal = await api.v1.ui.modal.open({
            title: "Greeting Emotion",
            content: [
              {
                type: "container",
                content: [
                  ...pickerParts
                ]
              }
            ],
            size: "small"
          });
        }
      },
      {
        type: "text",
        text: "Default Intimacy",
        style: { marginBottom: "4px" }
      },
      {
        type: "button",
        id: "defaultIntimacyBtn",
        style: { textTransform: "capitalize" },
        text: char.defaultIntimacy,
        callback: async () => {
          let pickerParts: UIPart[] = [];
          for (const intimacy of INTIMACY_LIST){
            pickerParts.push(
              {
