                callback: async () => {
                  char.defaultIntimacy = intimacy;
                  await saveCharList();
                  await reflectCharChangesInChatSettings(char);
                  await api.v1.ui.updateParts([{id: "defaultIntimacyBtn", text: intimacy}]);
                  pickerModal.close();
