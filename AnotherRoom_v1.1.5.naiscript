/**
 * For making sense linguistically as "emotion feelings"
 * e.g. "angry feelings" or "loving feelings"
 */
const EMOTION_TO_PHRASING: Record<Emotion, string> = {
  "angry": "angry",
  "aroused": "aroused",
  "bored": "bored",
  "confused": "confused",
  "determined": "determined",
  "disgusted": "disgusted",
  "embarrassed": "embarrassed",
  "excited": "excited",
  "happy": "happy",
  "hurt": "injury",
  "irritated": "irritated",
  "laughing": "amused",
  "love": "loving",
  "nervous": "nervous",
  "neutral": "neutral",
  "playful": "playful",
  "sad": "sad",
  "scared": "scared",
  "shy": "shy",
  "smug": "smug",
  "surprised": "surprised",
  "thinking": "analytical",
  "tired": "wearied",
  "worried": "worried"
} as const;

/**
 * The latest N emotions in the story text, or neutral if none are found.
 * If less than the total is found, should whatever it can find, which is fine for our purposes.
 */
async function getMostRecentEmotions(totalToFind: number) : Promise<Emotion[]>
{
  let emotionList = [];
  let foundCount = 0;
  const sections = await api.v1.document.scan();
  const reversed = sections.reverse();
  for (const section of reversed){
    const matchEmotion = section.section.text.match(/(?<=\s\sEmotion:\s)(\b\w+)/g);
    if (matchEmotion){
      emotionList.push(matchEmotion[0]);
      foundCount++;
      if (foundCount >= totalToFind){
        break;
      }
    }
  }
  if (emotionList.length === 0){
    emotionList.push("neutral");
  }
  return emotionList;
}

/**
 * Helper function for removing some possible generated junk from AI generated Activation Keys.
 * Such as "" and ending in a </think>
 */
function removeJunk(list: string[], junk: string) : string[]
{
  let newList: string[] = [];
  for (const item of list){
    newList.push(item.replaceAll(junk, ""));
  }
  return newList;
}

function diaryPageRebuild(combinedId: string, currentPage: DiaryPage) : UIPart[]
{
  let uiPartsList: UIPart[] = [];
  if (currentPage === "DiaryEntries"){
    uiPartsList.push(
      {
        type: "text",
        markdown: true,
        text: "**Contact reflections on the chat**"
      },
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "button",
            text: "Reflect",
            iconId: "book",
            callback: async () => {
              /**
               * Remove match from array. List order is not maintained.
               */
              function deleteIfPresent(text: string, list: string[]) : string[]
              {
                const index = list.indexOf(text);
                if (index !== -1){
                  list[index] = list[list.length - 1];
                  list.pop();
                }
                return list;
              }

              const prefixPrimer = `${chatSettings.char!.name}: Title:`;

              const response = await api.v1.generateWithStory( 
                [
                  { role: "system", content: "A diary entry consists of a Title:, Content:, and Activation Keys:" },
                  { role: "system", content: "[ Style: diary entry, reflection on events ]" },
                  { role: "assistant", content: prefixPrimer },
                ],
                { model: "xialong-v1", max_tokens: 250, temperature: 0.85, top_p: 0.95, top_k: 250, min_p: 0.0 }
              );
              const text = prefixPrimer + response.choices[0].text;
              api.v1.log(text);
              const title = getMatchInText("Title", text);
              const content = getMatchInText("Content", text);
              const activationKeys = getMatchInText("Activation Keys", text);
              let keysAsList = activationKeys.split(",");
              keysAsList = keysAsList.map(item => item.trim());
              // Remove Contact/User name as key if present because if they're used as keys,
              // the entry will pretty much always be active, which is not what we want.
              keysAsList = deleteIfPresent(chatSettings.char!.name, keysAsList);
              keysAsList = deleteIfPresent(chatSettings.user!.name, keysAsList);
              keysAsList = removeJunk(keysAsList, "\"");
              keysAsList = removeJunk(keysAsList, "</think>");

              api.v1.log(`Title: ${title}`);
              api.v1.log(`Content: ${content}`);
              api.v1.log(`ActivationKeys: ${keysAsList}`);
              const newBrain: BrainConditional = {
                name: title, 
                content: content, 
                keys: keysAsList
              };
              if (!diaryBrainsRecord[combinedId]){
                diaryBrainsRecord[combinedId] = [];
              }
              diaryBrainsRecord[combinedId].push(newBrain);
              await saveDiaryBrains();
              await updateDiaryPage(combinedId, currentPage);
            },
            disabledWhileCallbackRunning: true
          },
        ]
      },
    );
    if (diaryBrainsRecord[combinedId]){
      const brainList = diaryBrainsRecord[combinedId];
      for (let i = 0; i < brainList.length; i++){
        uiPartsList.push(
          {
            type: "container",
            style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
            content: [
              {
                type: "text",
                text: "Name"
              },
              {
                type: "text",
                text: brainList[i].name
              },
              {
                type: "text",
                text: "Content"
              },
              {
                type: "text",
                text: brainList[i].content
              },
              {
                type: "text",
                text: "Keys"
              },
              {
                type: "textInput",
                initialValue: brainList[i].keys.join(", "),
                onChange: async (val) => {
                  let valAsList = val.split(",");
                  valAsList = valAsList.map(item => item.trim());
                  diaryBrainsRecord[combinedId][i].keys = valAsList;
                  await saveDiaryBrains();
                }
              },
              {
                type: "button",
                text: "Delete",
                iconId: "delete",
                callback: async () => {
                  diaryBrainsRecord[combinedId].splice(i, 1);
                  await saveDiaryBrains();
                  await updateDiaryPage(combinedId, currentPage);
                }
              }
            ]
          }
        );
      }
    }
  }
  else if (currentPage === "CurrentPlans"){
    uiPartsList.push(
      {
        type: "text",
        markdown: true,
        text: "**Contact's ongoing plans for the chat**"
      },
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "button",
            text: "Plan",
            iconId: "file-text",
            callback: async () => {
              const prefixPrimer = `${chatSettings.char!.name}: Title:`;

              const response = await api.v1.generateWithStory( 
                [
                  { role: "system", content: `An action plan consists of a Title: and Content:, formatted as a single paragraph. The plan is one or more actions that can be taken in the chat, written in the unique style and tone of the author.` },
                  { role: "system", content: "[ Style: action plan, authentic expression ]" },
                  { role: "assistant", content: prefixPrimer },
                ],
                { model: "xialong-v1", max_tokens: 300, temperature: 0.85, top_p: 0.95, top_k: 250, min_p: 0.0 }
              );
              const text = prefixPrimer + response.choices[0].text;
              api.v1.log(text);
              const title = getMatchInText("Title", text);
              const content = getMatchInText("Content", text);
              const newPlan: ActionPlan = {
                name: title, 
                content: content,
                startedAtCount: -1,
                totalTurns: ACTION_PLAN_STANDARD_TURNS,
                remainingTurns: ACTION_PLAN_STANDARD_TURNS,
                running: false,
                planType: "AI",
                durationType: "Limited"
              };
              if (!actionPlansRecord[combinedId]){
                actionPlansRecord[combinedId] = [];
              }
              actionPlansRecord[combinedId].push(newPlan);
              await saveActionPlans();
              await updateDiaryPage(combinedId, currentPage);
            },
            disabledWhileCallbackRunning: true
          },
        ]
      },
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "button",
            text: "Add Manual Plan",
            iconId: "file-text",
            callback: async () => {
              const newPlan: ActionPlan = {
                name: "", 
                content: "",
                startedAtCount: -1,
                totalTurns: ACTION_PLAN_STANDARD_TURNS,
                remainingTurns: ACTION_PLAN_STANDARD_TURNS,
                running: false,
                planType: "User",
                durationType: "Limited"
              };
              if (!actionPlansRecord[combinedId]){
                actionPlansRecord[combinedId] = [];
              }
              actionPlansRecord[combinedId].push(newPlan);
              await saveActionPlans();
              await updateDiaryPage(combinedId, currentPage);
            }
          }
        ]
      }
    );
    if (actionPlansRecord[combinedId]){
      const planList = actionPlansRecord[combinedId];
      for (let i = 0; i < planList.length; i++){
        // In case user has existing plans from before planType was added,
        // undefined defaults to AI genned plan UI (that was the only one available before).
        if (!planList[i].planType ||  planList[i].planType === "AI"){
          uiPartsList.push(
            {
              type: "container",
              style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
              content: [
                {
                  type: "text",
                  text: "Name"
                },
                {
                  type: "text",
                  text: planList[i].name
                },
                {
                  type: "text",
                  text: "Content"
                },
                {
                  type: "text",
                  text: planList[i].content
                },
                {
                  type: "text",
                  text: `Remaining Turns: ${planList[i].remainingTurns}`
                },
                {
                  type: "button",
                  text: "Delete",
                  iconId: "delete",
                  callback: async () => {
                    actionPlansRecord[combinedId].splice(i, 1);
                    await saveActionPlans();
                    await updateDiaryPage(combinedId, currentPage);
                  }
                }
              ]
            }
          );
        }
        else if (planList[i].planType === "User"){
          uiPartsList.push(
            {
              type: "container",
              style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
              content: [
                {
                  type: "textInput",
                  label: "Name (not seen by AI)",
                  initialValue: planList[i].name,
                  onChange: async (val) => {
                    actionPlansRecord[combinedId][i].name = val;
                    await saveActionPlans();
                  }
                },
                {
                  type: "multilineTextInput",
                  label: "Content (first person recommended)",
                  initialValue: planList[i].content,
                  onChange: async (val) => {
                    actionPlansRecord[combinedId][i].content = val;
                    await saveActionPlans();
                  }
                },
                {
                  type: "text",
                  text: "Remaining Turns or Ongoing (∞)"
                },
                {
                  type: "row",
                  alignment: "center",
                  spacing: "start",
                  content: [
                    {
                      type: "numberInput",
                      initialValue: planList[i].remainingTurns,
                      onChange: async (val) => {
                        const asNumber = parseInt(val);
                        if (asNumber >= 0){
                          // If the user changes the value, we need to reset the plan to accommodate.
                          // Otherwise, it could be like 1 turn remaining > user changes to 5 > plan ends anyway.
                          actionPlansRecord[combinedId][i].remainingTurns = asNumber;
                          actionPlansRecord[combinedId][i].totalTurns = asNumber;
                          actionPlansRecord[combinedId][i].startedAtCount = -1;
                          actionPlansRecord[combinedId][i].running = false;
                          await saveActionPlans();
                        }
                      }
                    },
                    {
                      type: "button",
                      id: `manualPlanDurationToggleBtn${i.toString()}`,
                      text: "∞",
                      style: { 
                        ...getToggleButtonStyle(getPlanDurationAsState(actionPlansRecord[combinedId][i].durationType))
                      },
                      callback: async () => {
                        if (!actionPlansRecord[combinedId][i].durationType || actionPlansRecord[combinedId][i].durationType === "Limited"){
                          actionPlansRecord[combinedId][i].durationType = "Ongoing";
                        }
                        else if (actionPlansRecord[combinedId][i].durationType === "Ongoing"){
                          actionPlansRecord[combinedId][i].durationType = "Limited";
                        }
                        await saveActionPlans();
                        await api.v1.ui.updateParts([
                          {
                            id: `manualPlanDurationToggleBtn${i.toString()}`,
                            style: { 
                              ...getToggleButtonStyle(getPlanDurationAsState(actionPlansRecord[combinedId][i].durationType))
                            },
                          }
                        ]);
                      }
                    }
                  ]
                },
                {
                  type: "button",
                  text: "Delete",
                  iconId: "delete",
                  callback: async () => {
                    actionPlansRecord[combinedId].splice(i, 1);
                    await saveActionPlans();
                    await updateDiaryPage(combinedId, currentPage);
                  }
                }
              ]
            }
          );
        }
      }
    }
  }
  else if (currentPage === "ForumThreads"){
    uiPartsList.push(
      {
        type: "text",
        markdown: true,
        text: "**Forum discussions about the chat**"
      },
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "button",
            text: "Create Forum Thread",
            callback: async () => {
              function parseContent(text: string)
              {
                let asList = text.split("\n");
                let indexOfSeparator = asList.indexOf("====");
                api.v1.log(indexOfSeparator);

                let content = "";

                // Make sure first line is actually as expected. AI might have done UserName:
                const matchColonName = asList[indexOfSeparator + 1].match(/([^:]+)(?=:)/);
                if (matchColonName){
                  const [before, after] = asList[indexOfSeparator + 1].split(":");
                  content += after;
                }
                
                let emotion: Emotion = "neutral";
                const indexOfEmotion = asList.findIndex(str => str.includes("Emotion:"));
                if (indexOfEmotion !== -1){
                  content += asList.slice(indexOfSeparator + 2, indexOfEmotion).join("\n");
                  
                  content = trimUnfinishedSentence(content);
                  
                  const matchEmotion = asList[indexOfEmotion].match(/(?<=Emotion:\s)(\b\w+)/g);
                  if (matchEmotion){
                    emotion = matchEmotion[0];
                  }
                  asList.splice(indexOfEmotion, 1);
                }
                return { content: content, emotion: emotion };
              }

              const prefixPrimer = "Thread:";

              const response = await api.v1.generateWithStory( 
                [
                  { role: "system", content: `The author of the forum thread is ${chatSettings.char!.name}. The format is as follows.
                  Thread: Thread Name
                  ====
                  Author Name
                  Body of post.
                    Emotion:` },
                  { role: "system", content: "[ Style: forum thread, discussing recent chat ]" },
                  { role: "assistant", content: prefixPrimer },
                ],
                { 
                  model: "xialong-v1", 
                  max_tokens: 250, 
                  temperature: 0.85, 
                  top_p: 0.95, 
                  top_k: 250, 
                  min_p: 0.0,
                }
              );
              const text = prefixPrimer + response.choices[0].text;
              api.v1.log(text);
              const title = getMatchInText("Thread", text);
              const postBody = parseContent(text);
              //const content = text.split("\n").slice(3).join("\n");
              api.v1.log(`Title: ${title}`);
              api.v1.log(`Content: ${postBody.content}`);
              api.v1.log(`Emotion: ${postBody.emotion}`);
              const newThread: ForumThread = {
                originalPost: {
                  title: title,
                  content: postBody.content,
                  emotion: postBody.emotion,
                  screenName: chatSettings.char!.name,
                  id: chatSettings.char!.id
                },
                replyList: []
              };
              if (!forumThreadsRecord[combinedId]){
                forumThreadsRecord[combinedId] = [];
              }
              forumThreadsRecord[combinedId].push(newThread);
              await saveForumThreads();
              await updateDiaryPage(combinedId, currentPage);
            },
            disabledWhileCallbackRunning: true
          }
        ]
      }
    );
    if (forumThreadsRecord[combinedId]){
      const threadList = forumThreadsRecord[combinedId];
      for (let i = 0; i < threadList.length; i++){
        uiPartsList.push(
          {
            type: "container",
            style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
            content: [
              {
                type: "text",
                text: threadList[i].originalPost.title
              },
              {
                type: "text",
                text: `by ${threadList[i].originalPost.screenName}`
              },
              {
                type: "text",
                text: `Replies: ${threadList[i].replyList.length.toString()}`
              },
              {
                type: "row",
                spacing: "start",
                style: { display: "flex", flexDirection: "row", flexWrap: "wrap", gap: "5px" },
                content: [
                  {
                    type: "button",
                    text: "Open",
                    iconId: "edit",
                    callback: async () => {
                      const opMsgBubble: UIPart = buildMessageBubble(
                        threadList[i].originalPost.screenName, threadList[i].originalPost.content, threadList[i].originalPost.emotion, 'contact', chatSettings.char!,
                        0, 0
                      );
                      
                      const threadModal = await api.v1.ui.modal.open({
                        title: "Forum Thread",
                        content: [
                          {
                            type: "text",
                            markdown: true,
                            text: `## ${threadList[i].originalPost.title}`
                          },
                          opMsgBubble,
                          {
                            type: "container",
                            id: "replyDisplayContainer",
                            content: [
                              ...forumReplyRebuild(threadList[i].replyList)
                            ]
                          },
                          {
                            type: "row",
                            alignment: "center",
                            spacing: "start",
                            content: [
                              {
                                type: "button",
                                text: "Add Comment",
                                callback: async () => {
                                  let threadSoFar = "Thread: ";
                                  threadSoFar += threadList[i].originalPost.title;
                                  threadSoFar += "\n====\n";
                                  threadSoFar += threadList[i].originalPost.screenName;
                                  threadSoFar += "\n";
                                  threadSoFar += threadList[i].originalPost.content;
                                  threadSoFar += `\n  Emotion: ${threadList[i].originalPost.emotion}`;
                                  for (const reply of threadList[i].replyList){
                                    threadSoFar += "\n====\n";
                                    threadSoFar += reply.screenName;
                                    threadSoFar += "\n";
                                    threadSoFar += reply.content;
                                    threadSoFar += `\n  Emotion: ${reply.emotion}`;
                                  }
                                  threadSoFar += "\n====\n";
                                  await genForumReply(threadSoFar, i, combinedId);
                                },
                                disabledWhileCallbackRunning: true,
                              }
                            ]
                          },
                        ],
                        size: "medium",
                      });
                      threadModal.closed.then( async () => {
                        await updateDiaryPage(combinedId, currentPage);
                      });
                    }
                  },
                  {
                    type: "button",
                    text: "Reflect",
                    iconId: "book",
                    callback: async () => {
                      /**
                       * Remove match from array. List order is not maintained.
                       */
                      function deleteIfPresent(text: string, list: string[]) : string[]
                      {
                        const index = list.indexOf(text);
                        if (index !== -1){
                          list[index] = list[list.length - 1];
                          list.pop();
                        }
                        return list;
                      }

                      const prefixPrimer = `${chatSettings.char!.name}: Title:`;

                      let threadSoFar = "Thread: ";
                      threadSoFar += threadList[i].originalPost.title;
                      threadSoFar += "\n====\n";
                      threadSoFar += threadList[i].originalPost.screenName;
                      threadSoFar += "\n";
                      threadSoFar += threadList[i].originalPost.content;
                      threadSoFar += `\n  Emotion: ${threadList[i].originalPost.emotion}`;
                      for (const reply of threadList[i].replyList){
                        threadSoFar += "\n====\n";
                        threadSoFar += reply.screenName;
                        threadSoFar += "\n";
                        threadSoFar += reply.content;
                        threadSoFar += `\n  Emotion: ${reply.emotion}`;
                      }

                      const response = await api.v1.generateWithStory( 
                        [
                          { role: "system", content: threadSoFar },
                          { role: "system", content: "A diary entry consists of a Title:, Content:, and Activation Keys:" },
                          { role: "system", content: "[ Style: diary entry, reflection on forum thread ]" },
                          { role: "assistant", content: prefixPrimer },
                        ],
                        { model: "xialong-v1", max_tokens: 250, temperature: 0.85, top_p: 0.95, top_k: 250, min_p: 0.0 }
                      );
                      const text = prefixPrimer + response.choices[0].text;
                      api.v1.log(text);
                      const title = getMatchInText("Title", text);
                      const content = getMatchInText("Content", text);
                      const activationKeys = getMatchInText("Activation Keys", text);
                      let keysAsList = activationKeys.split(",");
                      keysAsList = keysAsList.map(item => item.trim());
                      // Remove Contact/User name as key if present because if they're used as keys,
                      // the entry will pretty much always be active, which is not what we want.
                      keysAsList = deleteIfPresent(chatSettings.char!.name, keysAsList);
                      keysAsList = deleteIfPresent(chatSettings.user!.name, keysAsList);
                      api.v1.log(`Title: ${title}`);
                      api.v1.log(`Content: ${content}`);
                      api.v1.log(`ActivationKeys: ${keysAsList}`);
                      const newBrain: BrainConditional = {
                        name: title, 
                        content: content, 
                        keys: keysAsList
                      };
                      if (!diaryBrainsRecord[combinedId]){
                        diaryBrainsRecord[combinedId] = [];
                      }
                      diaryBrainsRecord[combinedId].push(newBrain);
                      await saveDiaryBrains();
                      await updateDiaryPage(combinedId, currentPage);
                    },
                    disabledWhileCallbackRunning: true
                  },
                  {
                    type: "button",
                    text: "Plan",
                    iconId: "file-text",
                    callback: async () => {
                      const prefixPrimer = `${chatSettings.char!.name}: Title:`;

                      let threadSoFar = "Thread: ";
                      threadSoFar += threadList[i].originalPost.title;
                      threadSoFar += "\n====\n";
                      threadSoFar += threadList[i].originalPost.screenName;
                      threadSoFar += "\n";
                      threadSoFar += threadList[i].originalPost.content;
                      threadSoFar += `\n  Emotion: ${threadList[i].originalPost.emotion}`;
                      for (const reply of threadList[i].replyList){
                        threadSoFar += "\n====\n";
                        threadSoFar += reply.screenName;
                        threadSoFar += "\n";
                        threadSoFar += reply.content;
                        threadSoFar += `\n  Emotion: ${reply.emotion}`;
                      }

                      const response = await api.v1.generateWithStory( 
                        [
                          { role: "system", content: threadSoFar },
                          { role: "system", content: `An action plan consists of a Title: and Content:, formatted as a single paragraph. The plan is one or more actions that can be taken in the chat, written in the unique style and tone of the author.` },
                          { role: "system", content: "[ Style: action plan, authentic expression ]" },
                          { role: "assistant", content: prefixPrimer },
                        ],
                        { model: "xialong-v1", max_tokens: 250, temperature: 0.85, top_p: 0.95, top_k: 250, min_p: 0.0 }
                      );
                      const text = prefixPrimer + response.choices[0].text;
                      api.v1.log(text);
                      const title = getMatchInText("Title", text);
                      const content = getMatchInText("Content", text);
                      const newPlan: ActionPlan = {
                        name: title, 
                        content: content,
                        startedAtCount: -1,
                        totalTurns: ACTION_PLAN_STANDARD_TURNS,
                        remainingTurns: ACTION_PLAN_STANDARD_TURNS,
                        running: false,
                        planType: "AI",
                        durationType: "Limited"
                      };
                      if (!actionPlansRecord[combinedId]){
                        actionPlansRecord[combinedId] = [];
                      }
                      actionPlansRecord[combinedId].push(newPlan);
                      await saveActionPlans();
                      await updateDiaryPage(combinedId, currentPage);
                    },
                    disabledWhileCallbackRunning: true
                  },
                ]
              },
              {
                type: "row",
                spacing: "start",
                content: [
                  {
                    type: "button",
                    text: "Delete",
                    iconId: "delete",
                    callback: async () => {
                      let deletionCheckModal = await api.v1.ui.modal.open({
                        title: "Delete Thread?",
                        size: 'small',
                        content: [
                          { type: "text", text: "Are you sure you want to delete the thread?" },
                          {
                            type: 'row',
                            style: { marginTop: '16px', gap: '8px', justifyContent: 'flex-end' },
                            content: [
                              { 
                                type: 'button', 
                                text: 'Cancel', 
                                callback: async () => { 
                                  deletionCheckModal.close();
                                } 
                              },
                              {
                                type: 'button',
                                text: 'Delete',
                                iconId: 'trash',
                                callback: async () => {
                                  forumThreadsRecord[combinedId].splice(i, 1);
                                  await saveForumThreads();
                                  await updateDiaryPage(combinedId, currentPage);
                                  deletionCheckModal.close();
                                }
                              }
                            ]
                          }
                        ]
                      });
                    }
                  }
                ]
              }
            ]
          }
        );
      }
    }
  }
  else if (currentPage === "EmotionalMemory"){
    uiPartsList.push(
      {
        type: "text",
        markdown: true,
        text: "**Contact emotional impressions from the chat.**"
      },
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "button",
            text: "Process",
            iconId: "smile",
            callback: async () => {
              /**
               * Remove match from array. List order is not maintained.
               */
              function deleteIfPresent(text: string, list: string[]) : string[]
              {
                const index = list.indexOf(text);
                if (index !== -1){
                  list[index] = list[list.length - 1];
                  list.pop();
                }
                return list;
              }

              const mostRecentEmotions: Emotion[] = await getMostRecentEmotions(10);
              api.v1.log(mostRecentEmotions);
              const randEmoIndex = api.v1.random.int(0, mostRecentEmotions.length - 1);
              const emotion = EMOTION_TO_PHRASING[mostRecentEmotions[randEmoIndex]];
              api.v1.log(emotion);

              const prefixPrimer = `${chatSettings.char!.name}: Title:`;

              const response = await api.v1.generateWithStory( 
                [
                  { role: "system", content: "A emotional memory consists of a Title:, Content:, and Activation Keys:\nIt is focused on how a particular small interaction made the person feel and can reference a recent interaction, or one that happened some time ago." },
                  { role: "system", content: `[ Style: emotional memory, brief, ${emotion} feelings ]` },
                  { role: "assistant", content: prefixPrimer },
                ],
                { model: "xialong-v1", max_tokens: 250, temperature: 0.85, top_p: 0.95, top_k: 250, min_p: 0.0 }
              );
              const text = prefixPrimer + response.choices[0].text;
              api.v1.log(text);
              const title = getMatchInText("Title", text);
              const content = getMatchInText("Content", text);
              const activationKeys = getMatchInText("Activation Keys", text);
              let keysAsList = activationKeys.split(",");
              keysAsList = keysAsList.map(item => item.trim());
              // Remove Contact/User name as key if present because if they're used as keys,
              // the entry will pretty much always be active, which is not what we want.
              keysAsList = deleteIfPresent(chatSettings.char!.name, keysAsList);
              keysAsList = deleteIfPresent(chatSettings.user!.name, keysAsList);
              keysAsList = removeJunk(keysAsList, "\"");
              keysAsList = removeJunk(keysAsList, "</think>");

              api.v1.log(`Title: ${title}`);
              api.v1.log(`Content: ${content}`);
              api.v1.log(`ActivationKeys: ${keysAsList}`);
              const newBrain: BrainConditional = {
                name: title, 
                content: content, 
                keys: keysAsList
              };
              if (!emotionalMemoryRecord[combinedId]){
                emotionalMemoryRecord[combinedId] = [];
              }
              emotionalMemoryRecord[combinedId].push(newBrain);
              await saveEmotionalMemories();
              await updateDiaryPage(combinedId, currentPage);
            },
            disabledWhileCallbackRunning: true
          },
        ]
      },
    );
    if (emotionalMemoryRecord[combinedId]){
      const brainList = emotionalMemoryRecord[combinedId];
      for (let i = 0; i < brainList.length; i++){
        uiPartsList.push(
          {
            type: "container",
            style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
            content: [
              {
                type: "text",
                text: "Name"
              },
              {
                type: "text",
                text: brainList[i].name
              },
              {
                type: "text",
                text: "Content"
              },
              {
                type: "text",
                text: brainList[i].content
              },
              {
                type: "text",
                text: "Keys"
              },
              {
                type: "textInput",
                initialValue: brainList[i].keys.join(", "),
                onChange: async (val) => {
                  let valAsList = val.split(",");
                  valAsList = valAsList.map(item => item.trim());
                  emotionalMemoryRecord[combinedId][i].keys = valAsList;
                  await saveEmotionalMemories();
                }
              },
              {
                type: "button",
                text: "Delete",
                iconId: "delete",
                callback: async () => {
                  emotionalMemoryRecord[combinedId].splice(i, 1);
                  await saveEmotionalMemories();
                  await updateDiaryPage(combinedId, currentPage);
                }
              }
            ]
          }
        );
      }
    }
  }
  else if (currentPage === "ContinuityCreation"){
    uiPartsList.push(
      {
        type: "text",
        markdown: true,
        text: "**Create example chats from chat history**"
      },
      {
        type: "row",
        alignment: "center",
        spacing: "start",
        content: [
          {
            type: "button",
            text: "Imitate",
            iconId: "activity",
            callback: async () => {
              const prefixPrimer = `Title:`;

              const response = await api.v1.generateWithStory( 
                [
                  { role: "system", content: `An example chat consists of a Title: and multi-paragraph content focused on showing a sample exchange between the character ${chatSettings.char!.name} and a random user, with at least one message from each of them. This helps illustrate the unique voice of the character and maintain it across chats. The character always includes the "  Emotion: " line at the end of a message, but the user does not.` },
                  { role: "system", content: "[ Style: example chat, character representation ]" },
                  { role: "assistant", content: prefixPrimer },
                ],
                { model: "xialong-v1", max_tokens: 1536, temperature: 0.85, top_p: 0.95, top_k: 250, min_p: 0.0 },
              );
              const text = prefixPrimer + response.choices[0].text;
              api.v1.log(text);
              const textAsLines = text.split("\n");
              const title = getMatchInText("Title", textAsLines[0]);
              const content = textAsLines.slice(1).join("\n");
              api.v1.log(`Title: ${title}`);
              api.v1.log(`Content: ${content}`);
              const newBrain: BrainEntry = {
                name: title, 
                content: content
              };
              const id = chatSettings.char!.id;
              if (!continuityCreationRecord[id]){
                continuityCreationRecord[id] = [];
              }
              continuityCreationRecord[id].push(newBrain);
              await saveContinuityCreationData();
              await updateDiaryPage(combinedId, currentPage);
            },
            disabledWhileCallbackRunning: true
          },
        ]
      },
    );
    const id = chatSettings.char!.id;
    if (continuityCreationRecord[id]){
      const brainList = continuityCreationRecord[id];
      for (let i = 0; i < brainList.length; i++){
        async function deleteGennedExample(exampleId: string, index: number)
        {
          continuityCreationRecord[exampleId].splice(index, 1);
          await saveContinuityCreationData();
        }
        
        uiPartsList.push(
          {
            type: "container",
            style: { padding: '10px', marginBottom: '8px', backgroundColor: 'bg1', borderRadius: '6px' },
            content: [
              {
                type: "button",
                text: "Add to Example Chats",
                iconId: "send",
                callback: async () => {
                  // Make sure current char id can match one in char list.
                  const charIdx = charList.findIndex(char => char.id === chatSettings.char!.id);
                  if (charIdx === -1){
                    api.v1.ui.toast(`${chatSettings.char!.name} not found in saved Contacts. Canceled operation.`, {type: "warning"});
                    return;
                  }

                  //api.v1.log(brainList[i].content);
                  
                  let guessedStyle: Style = "chat";
                  // Do a simple check that stores style as RP if asterisk is included.
                  // This doesn't matter very much as style is not actually used in the AI-seen context produced by an example chat.
                  if (brainList[i].content.includes("*")){
                    guessedStyle = "roleplay";
                  }

                  let newExampleChat: ExampleChat = {
                    name: brainList[i].name,
                    style: guessedStyle,
                    userName: getRandomNameFull(),
                    messages: []
                  };
                  
                  const asList: string[] = brainList[i].content.split("\n");
                  const prependReggie = /^[^:]+:/;
                  type MsgParseState = "Char" | "User" | "None";
                  let msgParseState: MsgParseState = "None";
                  let currentLines: string[] = [];

                  function removePrepend(line: string) : string
                  {
                    const idx = line.indexOf(":") + 2;
                    return line.substring(idx);
                  }

                  function saveLastMsg()
                  {
                    // Save the most recently finished part.
                    let isChar = false;
                    currentLines[0] = removePrepend(currentLines[0]);
                    let emotion = undefined;
                    if (msgParseState == "Char"){
                      isChar = true;
                      const matchEmotion = currentLines[currentLines.length - 1].match(/(?<=\s\sEmotion:\s)(\b\w+)/g);
                      if (matchEmotion){
                        emotion = matchEmotion[0];
                        currentLines.length = currentLines.length - 1;
                      }
                    }
                    newExampleChat.messages.push(
                      {
                        isContact: isChar,
                        text: currentLines.join("\n"),
                        emotion: emotion
                      }
                    );
                    currentLines.length = 0;
                  }

                  for (const line of asList){
                    if (line.startsWith(`${chatSettings.char!.name}:`)){
                      if (msgParseState !== "None"){
                        saveLastMsg();
                      }
                      msgParseState = "Char";
                    }
                    else if (!line.startsWith("  Emotion:") && prependReggie.test(line)){
                      if (msgParseState !== "None"){
                        saveLastMsg();
                      }
                      msgParseState = "User";
                    }
                    currentLines.push(line);
                  }
                  if (currentLines.length > 0){
                    saveLastMsg();
                    msgParseState = "None";
                  }
                  //api.v1.log(newExampleChat);

                  charList[charIdx].exampleChats.push(newExampleChat);
                  chatSettings.char!.exampleChats.push(newExampleChat);
                  await saveCharList();

                  await deleteGennedExample(id, i);
                  await updateDiaryPage(combinedId, currentPage);

                  api.v1.ui.toast(`Example chat added to ${chatSettings.char!.alias || chatSettings.char!.name}`);
                }
              },
              {
                type: "text",
                text: "Title"
              },
              {
                type: "text",
                text: brainList[i].name
              },
              {
                type: "text",
                text: "Content"
              },
              {
                type: "text",
                text: brainList[i].content
              },
              {
                type: "button",
                text: "Delete",
                iconId: "delete",
                callback: async () => {
                  await deleteGennedExample(id, i);
                  await updateDiaryPage(combinedId, currentPage);
                }
              }
            ]
          }
        );
      }
    }
  }
  else{
    return [];
  }
  return uiPartsList;
}

function ImageCropAndResize( props: { image: string, onConvert: (dataUrl: string) => void } ) {
  const previewCanvasRef = useRef<any>(null);   // displays preview + crop overlay
  const finalCanvasRef = useRef<any>(null);     // used for progressive downscaling (main)
  const tempCanvasRef = useRef<any>(null);      // used for progressive downscaling (swap)

  const [status, setStatus] = useState('Select an image...');
  const [originalImage, setOriginalImage] = useState<any>(null);
  const [previewScale, setPreviewScale] = useState(1);
  const [previewSize, setPreviewSize] = useState<{ w: number; h: number } | null>(null);
  const [crop, setCrop] = useState({ x: 0, y: 0, w: 128, h: 128 });
  const [convertedUrl, setConvertedUrl] = useState<string | null>(null);

  const targetWidth = 128;
  const targetHeight = 128;
  const aspectRatio = targetWidth / targetHeight;
  const LAST_CROP_VAL_TEMP_KEY = "lastCropValuesTempKey";

  // Load saved crop from tempStorage
  const loadSavedCrop = async (defaultCrop: typeof crop) => {
    try {
      const saved = await api.v1.tempStorage.get(LAST_CROP_VAL_TEMP_KEY);
      if (saved && typeof saved.x === 'number' && typeof saved.y === 'number' && typeof saved.w === 'number' && typeof saved.h === 'number') {
        api.v1.log('Loaded saved crop', saved);
        return saved as typeof crop;
      }
    } catch (e) { /* ignore */ }
    return defaultCrop;
  };

  // Save crop to tempStorage
  const saveCrop = async (newCrop: typeof crop) => {
    try {
      await api.v1.tempStorage.set(LAST_CROP_VAL_TEMP_KEY, { x: newCrop.x, y: newCrop.y, w: newCrop.w, h: newCrop.h });
    } catch (e) { /* ignore */ }
  };

  // Redraw preview canvas (image + dark overlay + crop rectangle)
  const redrawPreview = async () => {
    const canvas = previewCanvasRef.current;
    if (!canvas || !originalImage) return;
    const ctx = await canvas.getContext('2d');
    ctx.drawImage(originalImage, 0, 0, canvas.width, canvas.height);
    ctx.fillStyle = 'rgba(0,0,0,0.5)';
    const { x, y, w, h } = crop;
    const { width, height } = canvas;
    if (x > 0) ctx.fillRect(0, 0, x, height);
    if (y > 0) ctx.fillRect(x, 0, w, y);
    if (x + w < width) ctx.fillRect(x + w, 0, width - (x + w), height);
    if (y + h < height) ctx.fillRect(x, y + h, w, height - (y + h));
    ctx.strokeStyle = 'white';
    ctx.lineWidth = 2;
    ctx.strokeRect(x, y, w, h);
  };

  const loadImage = async () => {
    setStatus('Decoding image...');
    try {
      const full = await createImageBitmap(props.image);
      api.v1.log(`Loaded: ${full.width}x${full.height}`);
      setOriginalImage(full);

      const maxPreview = 200;
      let pw = full.width, ph = full.height, scale = 1;
      if (pw > maxPreview || ph > maxPreview) {
        scale = Math.min(maxPreview / pw, maxPreview / ph);
        pw = Math.floor(full.width * scale);
        ph = Math.floor(full.height * scale);
      }
      setPreviewScale(scale);
      setPreviewSize({ w: pw, h: ph });
      setStatus(`Loaded ${full.width}x${full.height}`);
    } catch (err: any) {
      api.v1.log(`Decode error: ${err.message}`);
      setStatus(`Error: ${err.message}`);
    }
  };

  useEffect(() => {
    if (props.image){
      loadImage();
    }
  }, [])

  // Initialize canvas and load saved crop when previewSize is ready
  useEffect(() => {
    if (!originalImage || !previewSize) return;
    const canvas = previewCanvasRef.current;
    if (!canvas) return;
    canvas.width = previewSize.w;
    canvas.height = previewSize.h;
    const defaultSize = Math.min(previewSize.w, previewSize.h);
    const defaultX = (previewSize.w - defaultSize) / 2;
    const defaultY = (previewSize.h - defaultSize) / 2;
    const defaultCrop = { x: defaultX, y: defaultY, w: defaultSize, h: defaultSize };
    loadSavedCrop(defaultCrop).then(savedCrop => {
      setCrop(savedCrop);
    });
  }, [originalImage, previewSize]);

  // Redraw on crop change, and save to storage
  useEffect(() => {
    if (originalImage && previewCanvasRef.current && previewSize) {
      redrawPreview();
      saveCrop(crop);
    }
  }, [crop, originalImage, previewSize]);

  // Update crop position (X,Y) and size (single slider)
  const updateCropPosition = (updates: Partial<Pick<typeof crop, 'x' | 'y'>>) => {
    if (!previewSize) return;
    let newCrop = { ...crop, ...updates };
    newCrop.x = Math.min(Math.max(0, newCrop.x), previewSize.w - crop.w);
    newCrop.y = Math.min(Math.max(0, newCrop.y), previewSize.h - crop.h);
    setCrop(newCrop);
  };

  const updateCropSize = (newSize: number) => {
    if (!previewSize) return;
    let w = Math.min(Math.max(10, newSize), Math.min(previewSize.w, previewSize.h));
    let h = w / aspectRatio;
    let x = crop.x, y = crop.y;
    if (x + w > previewSize.w) x = previewSize.w - w;
    if (y + h > previewSize.h) y = previewSize.h - h;
    if (x < 0) x = 0;
    if (y < 0) y = 0;
    setCrop({ x, y, w, h });
  };

  // Progressive downscaling using two canvas refs (no createElement)
  const progressiveDownscale = async (sourceCanvas: any, targetWidth: number, targetHeight: number): Promise<any> => {
    const canvasA = finalCanvasRef.current;
    const canvasB = tempCanvasRef.current;
    if (!canvasA || !canvasB) throw new Error('Canvas refs missing');

    // Copy source to canvasA (the source is the cropped region drawn onto a canvas? Actually we need to draw the crop onto canvasA first)
    // We'll do that before calling this function. For now, assume canvasA already contains the cropped image at full crop resolution.
    let currentW = canvasA.width;
    let currentH = canvasA.height;
    let ctxA = await canvasA.getContext('2d');
    let ctxB: any = null;

    while (currentW > targetWidth * 1.1) {
      const nextW = Math.max(targetWidth, Math.floor(currentW / 2));
      const nextH = (nextW * currentH) / currentW;

      canvasB.width = nextW;
      canvasB.height = nextH;
      ctxB = await canvasB.getContext('2d');
      ctxB.imageSmoothingEnabled = true;
      ctxB.imageSmoothingQuality = 'high';
      ctxB.drawImage(canvasA, 0, 0, nextW, nextH);

      canvasA.width = nextW;
      canvasA.height = nextH;
      ctxA = await canvasA.getContext('2d');
      ctxA.imageSmoothingEnabled = true;
      ctxA.imageSmoothingQuality = 'high';
      ctxA.drawImage(canvasB, 0, 0);

      currentW = nextW;
      currentH = nextH;
    }

    // Final exact resize if needed
    if (Math.abs(currentW - targetWidth) > 1) {
      canvasB.width = targetWidth;
      canvasB.height = targetHeight;
      ctxB = await canvasB.getContext('2d');
      ctxB.imageSmoothingEnabled = true;
      ctxB.imageSmoothingQuality = 'high';
      ctxB.drawImage(canvasA, 0, 0, targetWidth, targetHeight);
      return canvasB;
    }
    return canvasA;
  };

  const cropAndConvert = async () => {
    if (!originalImage) return;
    // Convert preview crop to original image coordinates
    const origCrop = {
      x: crop.x / previewScale,
      y: crop.y / previewScale,
      w: crop.w / previewScale,
      h: crop.h / previewScale,
    };
    setStatus('Cropping and progressive downscaling...');
    try {
      // Step 1: Draw the cropped region onto finalCanvasRef at its full resolution
      const cropCanvas = finalCanvasRef.current;
      cropCanvas.width = origCrop.w;
      cropCanvas.height = origCrop.h;
      const ctx = await cropCanvas.getContext('2d');
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(originalImage, origCrop.x, origCrop.y, origCrop.w, origCrop.h, 0, 0, origCrop.w, origCrop.h);

      // Step 2: Progressive downscale to target size
      const finalCanvas = await progressiveDownscale(cropCanvas, targetWidth, targetHeight);

      // Step 3: Convert to AVIF with fallback
      setStatus('Converting to AVIF...');
      let avif = await (finalCanvas as any).toDataURL('image/avif', 0.7);
      if (!avif.startsWith('data:image/avif')) {
        avif = await (finalCanvas as any).toDataURL('image/webp', 0.8);
        if (!avif.startsWith('data:image/webp')) {
          avif = await (finalCanvas as any).toDataURL('image/jpeg', 0.85);
        }
      }
      setConvertedUrl(avif);
      props.onConvert(avif);
      setStatus(`Done! ${Math.round(avif.length / 1024)} KB`);
      originalImage.close();
      setOriginalImage(null);
      setPreviewSize(null);
    } catch (err: any) {
      setStatus(`Error: ${err.message}`);
      api.v1.log(err);
    }
  };

  return (
    <div style={{ padding: '1em', color: 'var(--theme-text-main)' }}>
      <div style={{ marginTop: '0.5em' }}>{status}</div>
      {previewSize && originalImage && (
        <div style={{ marginTop: '1em' }}>
          <div style={{ display: 'inline-block', border: '1px solid var(--theme-bg3)' }}>
            <canvas ref={previewCanvasRef} style={{ display: 'block' }} />
          </div>
          <div style={{ marginTop: '1em', display: 'flex', flexDirection: 'column', gap: '0.5em', maxWidth: '300px' }}>
            <label>X: <input type="range" min="0" max={previewSize.w - crop.w} step="1" value={crop.x} onChange={e => updateCropPosition({ x: Number(e.target.value) })} /> {Math.round(crop.x)}</label>
            <label>Y: <input type="range" min="0" max={previewSize.h - crop.h} step="1" value={crop.y} onChange={e => updateCropPosition({ y: Number(e.target.value) })} /> {Math.round(crop.y)}</label>
            <label>Size: <input type="range" min="10" max={Math.min(previewSize.w, previewSize.h)} step="1" value={crop.w} onChange={e => updateCropSize(Number(e.target.value))} /> {Math.round(crop.w)}×{Math.round(crop.h)}</label>
          </div>
          <div style={{ marginTop: '1em' }}>
            <button onClick={cropAndConvert}>Crop & Convert to {targetWidth}×{targetHeight}</button>
          </div>
          <div style={{ fontSize: '1em', marginTop: '1em' }}>
            Crop values saved per session. Use X/Y to position. Size to set square crop.
          </div>
        </div>
      )}
      <canvas ref={finalCanvasRef} style={{ display: 'none' }} />
      <canvas ref={tempCanvasRef} style={{ display: 'none' }} />
      {convertedUrl && (
        <div style={{ marginTop: '1em' }}>
          <h4>Result</h4>
          <img src={convertedUrl} style={{ maxWidth: '100%' }} />
        </div>
      )}
    </div>
  );
}

async function getCropAndResizeFromModal(image: string) : Promise<string>
{
  let convertedImg = "";
  const resizerModal = await api.v1.ui.modal.open({
    title: "Crop and Resize",
    content: [
      api.v1.ui.part.jsx({
        onMount: (root) => render(
          <ImageCropAndResize
            image={image}
            onConvert={(avifDataURL) => {
              convertedImg = avifDataURL;
              resizerModal.close();
            }}
          />, 
          root
          ),
      }),
    ],
    size: "medium"
  });
  await resizerModal.closed.then( () => {
    return convertedImg;
  });
  return convertedImg;
}

const IMAGE_SIZE_LIMIT: number = 20; // in kb

async function imageSizeCheckPassed(data: string) : Promise<boolean>
{
  const base64Part = data.split(",")[1] || data;
  const approximateSizeBytes = (base64Part.length * 3) / 4;
  const sizeKB = approximateSizeBytes / 1024;
  if (sizeKB > IMAGE_SIZE_LIMIT) {
    return false;
  }
  return true;
}

