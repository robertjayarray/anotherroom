                  await reflectCharChangesInChatSettings(char);
                }
              },
              {
                type: "button",
                id: `intimacyBrainConditionalBtn${i}`,
                text: `Intimacy: ${char.brainsConditional[i].requiredIntimacy}`,
                callback: async () => {
                  let pickerParts: UIPart[] = [];
                  for (const intimacy of REQUIRED_INTIMACY_LIST){
                    pickerParts.push(
                      {
                        type: "button",
                        text: intimacy,
                        callback: async () => {
                          char.brainsConditional[i].requiredIntimacy = intimacy;
                          await saveCharList();
                          await reflectCharChangesInChatSettings(char);
                          await api.v1.ui.updateParts([{id: `intimacyBrainConditionalBtn${i}`, text: `Intimacy: ${intimacy}`}]);
                          pickerModal.close();
                        }
                      }
                    );
                  }
                  const pickerModal = await api.v1.ui.modal.open({
                    title: "Required Intimacy",
                    content: [
                      {
                        type: "container",
                        content: [
